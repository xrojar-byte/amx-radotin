//////////////////////////////  -----------  LOZNICE  ------------  ////////////////////////////////////////////
DEFINE_CALL 'RGB_2NP_HEART_TIMER' 	// SPUSTENI EFEKTU PRO 2NP LOZNICE ANGEL 
{
	IF (RGB_2NP_HEART_TIMER_ACTIVE=TRUE)
		{
		CALL 'REQUEST_CHANNELS_2NP_LOZNICE_RGB_ANGEL'
		IF (RGB_2NP_HEART_01_ACTIVE=TRUE)	/// LOZNICE ANDEL SRDCE BILA TMAVE
			{
			//SEND_STRING 0,'TIMER HEART 1 START'
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,05,0)							///
			WAIT 10 'EFEKT_2NP_LOZNICE_ANGEL'
				{
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_22,00,0)	// RED
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_23,00,0)	// GREEN
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_24,00,0)	// BLUE
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,00,0)	// WHITE						///
				WAIT 10 'EFEKT_2NP_LOZNICE_ANGEL'
					{
					//SEND_STRING 0,'TIMER HEART 3'
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,05,0)							///
					WAIT 10 'EFEKT_2NP_LOZNICE_ANGEL'
						{
						//SEND_STRING 0,'TIMER HEART 4'
						CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,00,0)							///
						WAIT 10 'EFEKT_2NP_LOZNICE_ANGEL'
							{
							CALL 'RGB_2NP_HEART_TIMER' 
							}
						}
					}
				}
			}
		ELSE IF (RGB_2NP_HEART_02_ACTIVE=TRUE)		/// SRDCE 2 BARVY TMAVE
			{
			//SEND_STRING 0,'TIMER HEART 1 START'
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_22,02,0)
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_23,02,0)
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_24,01,0)
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,02,0)							///
			WAIT 10 'EFEKT_2NP_LOZNICE_ANGEL'
				{
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_22,00,0)
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_23,00,0)
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_24,00,0)
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,00,0)							///
				WAIT 10 'EFEKT_2NP_LOZNICE_ANGEL'
					{
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_22,02,0)
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_23,02,0)
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_24,01,0)
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,02,0)							///
					WAIT 10 'EFEKT_2NP_LOZNICE_ANGEL'
						{
						//SEND_STRING 0,'TIMER HEART 4'
						CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_22,00,0)
						CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_23,00,0)
						CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_24,00,0)
						CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,00,0)
						WAIT 10 'EFEKT_2NP_LOZNICE_ANGEL'
							{
							CALL 'RGB_2NP_HEART_TIMER' 
							}
						}
					}
				}
			}
		ELSE IF (RGB_2NP_HEART_03_ACTIVE=TRUE)			/// SRDCE BILA SVETLE
			{
			SEND_STRING 0,'TIMER HEART 1 START'
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,30,0)							///
			WAIT 10 'EFEKT_2NP_LOZNICE_ANGEL'
				{
				//SEND_STRING 0,'TIMER HEART 2'
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,20,00)							///
				WAIT 10 'EFEKT_2NP_LOZNICE_ANGEL'
					{
					//SEND_STRING 0,'TIMER HEART 3'
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,30,0)							///
					WAIT 10 'EFEKT_2NP_LOZNICE_ANGEL'
						{
						//SEND_STRING 0,'TIMER HEART 4'
						CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,20,00)							///
						WAIT 10 'EFEKT_2NP_LOZNICE_ANGEL'
							{
							CALL 'RGB_2NP_HEART_TIMER' 
							}
						}
					}
				}
			}
		ELSE IF (RGB_2NP_HEART_04_ACTIVE=TRUE)			/// BARVY SVETLE
			{
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_22,25,0)
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_23,30,0)
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_24,20,0)
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,10,0)							///
			WAIT 10 'EFEKT_2NP_LOZNICE_ANGEL'
				{
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_22,15,0)
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_23,20,0)
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_24,12,0)
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,05,00)							///
				WAIT 10 'EFEKT_2NP_LOZNICE_ANGEL'
					{
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_22,25,0)
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_23,30,0)
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_24,20,0)
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,10,0)											///
					WAIT 10 'EFEKT_2NP_LOZNICE_ANGEL'
						{
						CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_22,15,0)
						CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_23,20,0)
						CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_24,12,0)
						CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,05,00)		
						WAIT 10 'EFEKT_2NP_LOZNICE_ANGEL'
							{
							CALL 'RGB_2NP_HEART_TIMER' 
							}
						}
					}
				}
			}
		
		ELSE IF (RGB_2NP_HEART_05_ACTIVE=TRUE)
			{
			//SEND_STRING 0,'TIMER HEART 3 START'
			CALL 'RGB_2NP_LOZ_ANGEL_TIMER'
			}
		ELSE IF (RGB_2NP_HEART_06_ACTIVE=TRUE)
			{
			//SEND_STRING 0,'TIMER HEART 3 START'
			CALL 'RGB_2NP_LOZ_ANGEL_TIMER'
			}
		}
	ELSE
		{
		CANCEL_WAIT 'EFEKT_2NP_LOZNICE_ANGEL'
		CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_22,0,2)
		CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_23,0,2)
		CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_24,0,2)
		CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,0,2)
		//SEND_STRING 0,'TIMER HEART STOP'
		}
}
DEFINE_CALL 'SEKVENCE_2NP_LOZ_ANGEL_START'
{
	CALL 'SEKVENCE_2NP_LOZNICE_ANGEL1'
	CALL 'SEKVENCE_2NP_LOZNICE_ANGEL2'
	//CALL 'SEKVENCE_2NP_LOZNICE_ANGEL1'
}
DEFINE_CALL 'SEKVENCE_2NP_LOZ_ANGEL_STOP'
{
	RGB_2NP_HEART_01_ACTIVE=FALSE 
	RGB_2NP_HEART_02_ACTIVE=FALSE
	RGB_2NP_HEART_03_ACTIVE=FALSE
	RGB_2NP_HEART_04_ACTIVE=FALSE 
	RGB_2NP_HEART_05_ACTIVE=FALSE
	RGB_2NP_HEART_06_ACTIVE=FALSE
	RGB_2NP_HEART_TIMER_ACTIVE=FALSE
	CANCEL_WAIT 'EFEKT_2NP_LOZNICE_ANGEL'
	// CALL 'RGB_2NP_HEART_TIMER' 
}

DEFINE_CALL 'RGB_2NP_LOZ_ANGEL_TIMER' // ZAKLADNI CASOVAC PRO LOZ ANGEL
{
	IF (RGB_2NP_LOZ_ANDEL_KROK > 12) 
		RGB_2NP_LOZ_ANDEL_KROK = 1
	IF (RGB_2NP_HEART_TIMER_ACTIVE=TRUE)
		{
			CALL 'SEKVENCE_2NP_LOZ_ANGEL_START'
			//SEND_STRING 0,'TIMER HEART KROK'
			WAIT 100 'EFEKT_2NP_LOZNICE_ANGEL'
				{
				RGB_2NP_LOZ_ANDEL_KROK++
				CALL 'REQUEST_CHANNELS_2NP_LOZNICE_RGB_ANGEL'
				CALL 'RGB_2NP_LOZ_ANGEL_TIMER'
				}
		}
	 
}	

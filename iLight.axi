DEFINE_CALL 'SEND_TO_ILIGHT' (CHAR cCMD[])
{
	ILT_QUEUE = "ILT_QUEUE,'@',cCMD,$0D" // PRIDAM DO FRONTY A PRIDAM ZACATEK+KONEC ZPRAVY
  IF (!(ILT_BUSY)) // MUZEME POSLAT HNED, JINAK JEN NECHAME VE FRONTE
	{
	  CALL 'SEND_TO_ILIGHT_PORT' 
	}
}

DEFINE_CALL 'SEND_TO_ILIGHT_PORT'
{
    ILT_TEMP = REMOVE_STRING(ILT_QUEUE,"$0D",1)
    IF (LENGTH_STRING(ILT_TEMP) > 0)
	   {
	   CANCEL_WAIT 'ILIGHT_TIMEOUT_BUSY' 
	   ILT_BUSY = TRUE
	   SEND_STRING dvIlight,"ILT_TEMP"		
	   WAIT 0.5 'ILIGHT_TIMEOUT_BUSY' // KVULI STMIVANI A ROZSVECENI 0.03 VTERINY ted zlobi, tak 0,5
		  {
			ILT_BUSY = FALSE
		  }
	   }
    ELSE  (* Garbage *)
	   {
		ILT_QUEUE = "''"
	   }
}
DEFINE_CALL 'ZPRACUJ_CIDLO_SCHODY' (CHAR sMESS[]) // VSTUPEM JE CAST Z1/Z0
{
    LOCAL_VAR CHAR sCISLO[2]
	sCISLO = "sMESS[1],sMESS[2]"
	//kPATRO = "'P',sMESS[1]"
	SEND_STRING 0,"'PRISLO CIDLO SCHODY NA CISLO : <',sCISLO,'>'" 
	//nAREA = ATOI(sMESS) // PREVEDE XXX:OFF NA CISELNOU PODOBU XXX
	SWITCH (sCISLO)
		{
		CASE 'Z0':
			{
			SEND_STRING 0,"'ZPRACUJ_CIDLO_SCHODY PRISLO CISLO 0 - NIC NEDELAM'"
			}
		CASE 'Z1':
			{
			 IF (DEN_NOC=0) 
				{
			  CANCEL_WAIT 'CIDLO SCHODY'
			  CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_SCHOZK_01,100,00)
			  CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_SCHOZK_02,00,00)
			  SEND_STRING 0,"'ZPRACUJ_CIDLO_SCHODY PRISLO CISLO 1 V NOCI '"
			  WAIT 550 'CIDLO SCHODY'
					{
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_SCHOZK_01,00,10)
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_SCHOZK_02,40,10)
					}
				}
			ELSE
				{
				CANCEL_WAIT 'CIDLO SCHODY'
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_SCHOZK_01,100,00)
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_SCHOZK_02,00,00)
				SEND_STRING 0,"'ZPRACUJ_CIDLO_SCHODY PRISLO CISLO 1 VE DNE '"
				WAIT 550 'CIDLO SCHODY'
					{
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_SCHOZK_01,00,10)
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_SCHOZK_02,00,10)
					}
				
				}
			}
		}
	
}
DEFINE_CALL 'ZPRACUJ_VYPADEK_NAPAJENI' (CHAR sMESS[]) // VSTUPEM JE CAST Z1/Z0
{
    LOCAL_VAR CHAR sCISLO[1]
	sCISLO = "sMESS[1]"
	//kPATRO = "'P',sMESS[1]"
	//SEND_STRING 0,"'PRISLO CISLO : <',sCISLO,'>'" 
	//nAREA = ATOI(sMESS) // PREVEDE XXX:OFF NA CISELNOU PODOBU XXX
	SWITCH (sCISLO)
		{
		CASE '0':
			{
			SEND_STRING 0,"'PRISLO CISLO 0'"		/// 0 - 
			NAPAJENI_VYPADEK=1
			CALL 'VYPADEK_ELEKTRINY'
			}
		CASE '1':
			{
			SEND_STRING 0,"'PRISLO CISLO 1'"
			NAPAJENI_VYPADEK=0					/// 1 - 
			CALL 'VYPADEK_ELEKTRINY'
			}
		}
}

DEFINE_CALL 'ZPRACUJ_MESSAGE_AREA' (CHAR sMESS[]) // VSTUPEM JE CAST XXX:OFF Z CELKOVE ZPRAVY @AR:XXX:OFF$0D - VYPINAM AREU
{
  STACK_VAR INTEGER nAREA
	nAREA = ATOI(sMESS) // PREVEDE XXX:OFF NA CISELNOU PODOBU XXX
	// IF (FIND_STRING(sMESS,"'OFF'",1)) // PRO PRIPAD DALSICH UZIVATELSKYCH ZPRAV S JINYM TEXTEM, NEZ OFF
	SWITCH (nAREA)
	{
	  CASE ILT_2NP_LOZNICE_AREA:
		{		
			SEND_STRING 0,"'PRISLO OFF PRO LOZNICI'"
			IF (RGB_2NP_LOZNICE_SEKVENCE <> RGB_2LOZ_00) // BEZI-LI SEKVENCE, OKAMZITE UKONCI, 
			// ALE NEBUDU SAHAT NA SVETLA ZE SEKVENCE, PROTOZE TY UZ JSOU NEJAK NASTAVENA DLE PRAVE VYVOLANE SCENY
				CALL 'SEKVENCE_2NP_LOZNICE_STOP'
				WAIT 8
				CALL 'SEKVENCE_2NP_LOZ_ANGEL_STOP'
				// BYLA VYVOLANA SCENA Z TLACITEK, TAK SE ZEPTAM NA JEJI CISLO PRO OBNOVU NA TP
				WAIT 20
				CALL 'ILIGHT_SCENA_REQUEST'(ILT_2NP_LOZNICE_AREA)
		}
		CASE ILT_2NP_DETPOK_AREA:
		{		
			SEND_STRING 0,"'DET POKOJ VYP '"
			IF (RGB_2NP_DETI_SEKVENCE <> RGB_2DET_00) // BEZI-LI SEKVENCE, OKAMZITE UKONCI, 
			// V POVELU STOP SEQ PRO DET POKOJ VYPINAM I SVETLA 
				CALL 'SEKVENCE_2NP_DETI_STOP'
				SEND_STRING 0,"'DET POKOJ SEQ STOP '"
			// BYLA VYVOLANA SCENA Z TLACITEK, TAK SE ZEPTAM NA JEJI CISLO PRO OBNOVU NA TP
				CALL 'ILIGHT_SCENA_REQUEST'(ILT_2NP_DETPOK_AREA)
		}
		CASE ILT_2NP_HALA_AREA:
		{		
			IF (RGB_2NP_HALA_SEKVENCE <> RGB_2HALA_00) // BEZI-LI SEKVENCE, OKAMZITE UKONCI, 
			// ALE NEBUDU SAHAT NA SVETLA ZE SEKVENCE, PROTOZE TY UZ JSOU NEJAK NASTAVENA DLE PRAVE VYVOLANE SCENY
				CALL 'SEKVENCE_2NP_HALA_STOP'
			// BYLA VYVOLANA SCENA Z TLACITEK, TAK SE ZEPTAM NA JEJI CISLO PRO OBNOVU NA TP
				CALL 'ILIGHT_SCENA_REQUEST'(ILT_2NP_HALA_AREA)
		}
		CASE ILT_2NP_KOUPELNA_AREA:
		{		
			IF (RGB_2NP_KOUPELNA_SEKVENCE <> RGB_2KOUP_00) // BEZI-LI SEKVENCE, OKAMZITE UKONCI, 
			// ALE NEBUDU SAHAT NA SVETLA ZE SEKVENCE, PROTOZE TY UZ JSOU NEJAK NASTAVENA DLE PRAVE VYVOLANE SCENY
				CALL 'SEKVENCE_2NP_KOUPELNA_STOP'
			// BYLA VYVOLANA SCENA Z TLACITEK, TAK SE ZEPTAM NA JEJI CISLO PRO OBNOVU NA TP
				CALL 'ILIGHT_SCENA_REQUEST'(ILT_2NP_KOUPELNA_AREA)
		}
		CASE ILT_1NP_KOUPELNA_AREA:
			{
			}
		CASE ILT_1NP_OBYVAK1_AREA:
			{
			RGB_1NP_OBYVAK_MOD = RGB_1NP_OBYVAK_00
			CALL 'SEKVENCE_1NP_OBYVAK_STOP'
			}
		CASE ILT_2NP_LOZNICE_OFF:
			{
			SEND_STRING 0,"'LOZNICE - ZASUVKY OFF'"
			}
		CASE ILT_2NP_LOZNICE_ON:
			{
			SEND_STRING 0,"'LOZNICE - ZASUVKY ON '"
			}
		CASE ILT_1NP_CHODBA_VSTUP_AREA:
			{
			}
		
	}
}
DEFINE_CALL 'ILIGHT_BUFFER_PROCESS'
{
  //SEND_STRING 0,"'ILIGHT_BUFFER_PROCESS START'"
	IF (LENGTH_STRING(ILT_BUFFER) > 1)
	{
	  //SEND_STRING 0,"'ILIGHT_BUFFER_PROCESS (LENGTH_STRING(ILT_BUFFER) > 1)'"
	  ///SEND_STRING 0,"'ILIGHT BUFFER: <',ILT_TEMP,'>'"   /// JENOM PRO TESTY
	  //SEND_STRING 0,"'-------------------------------------'"   /// JENOM PRO TESTY
		ILT_TEMP = REMOVE_STRING(ILT_BUFFER,"$0D",1)
		IF (LENGTH_STRING(ILT_TEMP)) 			// JE TAM ALESPON JEDNA CELA ZPRAVA, ZPRACUJU
		{
		  //SEND_STRING 0,"'ILIGHT_BUFFER_PROCESS (LENGTH_STRING(ILT_TEMP))'"
			IF (FIND_STRING(ILT_TEMP,"'@RL'",1)) // Report Channel Level
			{
			REMOVE_STRING(ILT_TEMP,"'@RL'",1) // ODSTRANIM VSE DO PRIZNAKU ZACATKU ZPRAVY VCETNE
  			SET_LENGTH_STRING(ILT_TEMP,(LENGTH_STRING(ILT_TEMP)-1)) // ODSTRANIM KONEC ZPRAVY
				//SEND_STRING 0,"'ILIGHT ODPOVIDA: <',ILT_TEMP,'>'"   /// JENOM PRO TESTY
				IF (UKLADANI_ACTIVE=TRUE)
					{
					CALL 'ULOZ LEVEL' (ILT_TEMP)
					}
				ELSE
					{
					CALL 'ZOBRAZ LEVEL' (ILT_TEMP)
					}
			}
			ELSE IF (FIND_STRING(ILT_TEMP,"'@RE'",1)) // Report Current Scene
			{
				REMOVE_STRING(ILT_TEMP,"'@RE'",1) // ODSTRANIM VSE DO PRIZNAKU ZACATKU ZPRAVY VCETNE
				SET_LENGTH_STRING(ILT_TEMP,(LENGTH_STRING(ILT_TEMP)-1)) // ODSTRANIM KONEC ZPRAVY
				//SEND_STRING 0,"'ILIGHT ODPOVIDA: <',ILT_TEMP,'>'"   /// JENOM PRO TESTY
				CALL 'ZOBRAZ SCENU' (ILT_TEMP)
			}
			ELSE IF (FIND_STRING(ILT_TEMP,"'@AR:'",1)) // R.STEPAN - DEFINOVANA ZPRAVA PRO VYVOLANI SCENY Z TLACITKA: @AR:XXX:OFF$0D , KDE XXX JE AREA
			{
				REMOVE_STRING(ILT_TEMP,"'@AR:'",1) // ODSTRANIM VSE DO PRIZNAKU ZACATKU ZPRAVY VCETNE
				SET_LENGTH_STRING(ILT_TEMP,(LENGTH_STRING(ILT_TEMP)-1)) // ODSTRANIM KONEC ZPRAVY
				//SEND_STRING 0,"'ILIGHT ODPOVIDA: <',ILT_TEMP,'>'"   /// JENOM PRO TESTY
				//SEND_STRING 0,"'PRISLO OFF'"   /// JENOM PRO TESTY
				CALL 'ZPRACUJ_MESSAGE_AREA' (ILT_TEMP)
			}	
			ELSE IF (FIND_STRING(ILT_TEMP,"'@Z'",1)) // R.STEPAN - DEFINOVANA ZPRAVA ZALUZII Z TLACITKA:, @Z1O2:D zpracovani v modulu Zaluzie!
			{
				REMOVE_STRING(ILT_TEMP,"'@Z'",1) // ODSTRANIM VSE DO PRIZNAKU ZACATKU ZPRAVY VCETNE
				SET_LENGTH_STRING(ILT_TEMP,(LENGTH_STRING(ILT_TEMP)-1)) // ODSTRANIM KONEC ZPRAVY
				SEND_STRING 0,"'ILIGHT ZALUZIE: <',ILT_TEMP,'>'"   /// JENOM PRO TESTY
				CALL 'ZPRACUJ_ZALUZIE_AREA' (ILT_TEMP)
			}	
			ELSE IF (FIND_STRING(ILT_TEMP,"'@CS'",1)) // R.STEPAN - DEFINOVANA ZPRAVA CIDLO SCHODY
			{
				REMOVE_STRING(ILT_TEMP,"'@CS'",1) // ODSTRANIM VSE DO PRIZNAKU ZACATKU ZPRAVY VCETNE
				SET_LENGTH_STRING(ILT_TEMP,(LENGTH_STRING(ILT_TEMP)-1)) // ODSTRANIM KONEC ZPRAVY
				//SEND_STRING 0,"'ILIGHT cidlo: <',ILT_TEMP,'>'"   /// JENOM PRO TESTY
				CALL 'ZPRACUJ_CIDLO_SCHODY' (ILT_TEMP)
			}	
			ELSE IF (FIND_STRING(ILT_TEMP,"'@ELS'",1)) // R.STEPAN - DEFINOVANA ZPRAVA PRO NAPAJENI
			{
				REMOVE_STRING(ILT_TEMP,"'@ELS'",1) // ODSTRANIM VSE DO PRIZNAKU ZACATKU ZPRAVY VCETNE
				SET_LENGTH_STRING(ILT_TEMP,(LENGTH_STRING(ILT_TEMP)-1)) // ODSTRANIM KONEC ZPRAVY
				SEND_STRING 0,"'ILIGHT napajeni: <',ILT_TEMP,'>'"   /// JENOM PRO TESTY
				SEND_STRING 0,"'-------------------------------------'"   /// JENOM PRO TESTY
				CALL 'ZPRACUJ_VYPADEK_NAPAJENI' (ILT_TEMP)
			}	
			// PO ZPRACOVANI JEDNE ZPRAVY ZNOVU DOTAZ, JE-LI CO ZPRACOVAVAT (JE-LI VE ZBYTKU DALSI CELA ZPRAVA), VOLAT ZNOVU
			IF (FIND_STRING(ILT_BUFFER,"$0D",1))
				CALL 'ILIGHT_BUFFER_PROCESS'
		}
		IF (LENGTH_STRING(ILT_BUFFER) >= (MAX_LENGTH_STRING(ILT_BUFFER)-20)) // MAME NESMYSLY V BUFFERU, TAK HO VYCISTIM
			CLEAR_BUFFER ILT_BUFFER
	}
	//SEND_STRING 0,"'ILIGHT_BUFFER_PROCESS STOP'"
}

DEFINE_CALL 'ILIGHT_CHANNEL_ON' (CHAR AREA_CHANNEL[2]) // POKUD PREDAM STM SVETLO, BUDE FUNGOVAT TAKY, I KDYZ MA TRI PRVKY - TADY SE POUZIVAJI JEN PRVNI DVA
{
  CALL 'ILIGHT_CHANNEL_VALUE' (AREA_CHANNEL,$FF,0) // FADETIME 0s
}
DEFINE_CALL 'ILIGHT_CHANNEL_ON2' (CHAR AREA_CHANNEL[2]) // POKUD PREDAM STM SVETLO, BUDE FUNGOVAT TAKY, I KDYZ MA TRI PRVKY - TADY SE POUZIVAJI JEN PRVNI DVA
{
  CALL 'ILIGHT_CHANNEL_VALUE' (AREA_CHANNEL,$FF,0) // FADETIME 0s
   WAIT 5 // LEVEL STACI OBNOVOVAT PO PUL VTERINE, NENI TREBA CASTEJI
		  CALL 'ILIGHT_CHANNEL_REQUEST' (AREA_CHANNEL)
}
DEFINE_CALL 'ILIGHT_CHANNEL_OFF' (CHAR AREA_CHANNEL[2])
{
  CALL 'ILIGHT_CHANNEL_VALUE' (AREA_CHANNEL,0,0) // FADETIME 0s
}
DEFINE_CALL 'ILIGHT_CHANNEL_OFF2' (CHAR AREA_CHANNEL[2])
{
  CALL 'ILIGHT_CHANNEL_VALUE' (AREA_CHANNEL,0,0) // FADETIME 0s
   WAIT 5 // LEVEL STACI OBNOVOVAT PO PUL VTERINE, NENI TREBA CASTEJI
		  CALL 'ILIGHT_CHANNEL_REQUEST' (AREA_CHANNEL)
}
DEFINE_CALL 'ILIGHT_CHANNEL_VALUE' (CHAR AREA_CHANNEL[2],CHAR VALUE, CHAR FADETIME) // value v procentech
{
  IF (VALUE>=100)
	  CALL 'SEND_TO_ILIGHT' ("'SC',FORMAT('%02d',AREA_CHANNEL[2]),':A',FORMAT('%02d',AREA_CHANNEL[1]),':LFF:F',FORMAT('%02d',FADETIME)")
	ELSE
	  CALL 'SEND_TO_ILIGHT' ("'SC',FORMAT('%02d',AREA_CHANNEL[2]),':A',FORMAT('%02d',AREA_CHANNEL[1]),':L',FORMAT('%02d',VALUE),':F',FORMAT('%02d',FADETIME)")
}

DEFINE_CALL 'ILIGHT_SCENA' (CHAR AREA_SCENA[2], CHAR FADETIME)
{
  CALL 'SEND_TO_ILIGHT' ("'SS',FORMAT('%02d',AREA_SCENA[2]),':A',FORMAT('%02d',AREA_SCENA[1]),':F',FORMAT('%02d',FADETIME)")
}
DEFINE_CALL 'ILIGHT_SCENA2' (CHAR SCENA,CHAR AREA,CHAR FADETIME)
{
  CALL 'SEND_TO_ILIGHT' ("'SS',FORMAT('%02d',SCENA),':A',FORMAT('%02d',AREA),':F',FORMAT('%02d',FADETIME)")
}

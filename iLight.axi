 CALL 'SEND_TO_ILIGHT' ("'RS',FORMAT('%02d',AREA)")				
}

DEFINE_CALL 'RGB_1PP_RELAX_TIMER' (CHAR CAS)	// ZAKLADNI CASOVAC PRO 0NP RELAX - SEKVENCE MUSI MIT STEJNOU DELKU
{
	RGB_1PP_RELAX_WAIT_TIME = 255
	IF (RGB_1PP_RELAX_KROK > 12) 
		RGB_1PP_RELAX_KROK = 1
	IF (KAMEN_RELAX_TIMER_ACTIVE=TRUE)
		{
			SEND_STRING 0,'TIMER RELAX START'
			CALL 'SEKVENCE_0NP_RELAX_START'
			//SEND_COMMAND dvMyTP_01,"'^TXT-51,0,','RGB CASE ',ITOA(RGB_1PP_RELAX_KROK)"
			//SEND_LEVEL dvMyTP_01,153,RGB_1PP_RELAX_KROK*7.15 // ASI BYCH ODSTRANIL, TEXT DLE MNE UPLNE STACI
			WAIT RGB_1PP_RELAX_WAIT_TIME 'SEKVENCE_0NP_RELAX_WAIT'
				{
				RGB_1PP_RELAX_KROK++
				CALL 'RGB_1PP_RELAX_TIMER' (CAS)
				}
		}
	 
}	
DEFINE_CALL 'RGB_1PP_RELAX_TIMER_FIX'	// CASOVAC PRO 0NP RELAX - SEKVENCE MUSI MIT STEJNOU DELKU
{
	IF (RGB_1PP_RELAX_KROK > 12) 
		RGB_1PP_RELAX_KROK = 1
	IF (KAMEN_RELAX_TIMER_ACTIVE=TRUE)
		{
			SEND_STRING 0,'TIMER RELAX START'
			CALL 'SEKVENCE_0NP_RELAX_START'
			//SEND_COMMAND dvMyTP_01,"'^TXT-51,0,','RGB CASE ',ITOA(RGB_1PP_RELAX_KROK)"
			//SEND_LEVEL dvMyTP_01,153,RGB_1PP_RELAX_KROK*7.15 // ASI BYCH ODSTRANIL, TEXT DLE MNE UPLNE STACI
			WAIT 400 'SEKVENCE_0NP_RELAX_WAIT'
				{
				RGB_1PP_RELAX_KROK++
				CALL 'RGB_1PP_RELAX_TIMER_FIX'
				}
		}
	 
}	
DEFINE_CALL 'SEKVENCE_0NP_RELAX_START'
{
	CALL 'SEKVENCE_0NP_RELAX_1'
	CALL 'SEKVENCE_0NP_RELAX_2'
	CALL 'SEKVENCE_0NP_RELAX_3'
	CALL 'SEKVENCE_0NP_RELAX_4'
	CALL 'SEKVENCE_0NP_RELAX_5'
	CALL 'SEKVENCE_0NP_RELAX_6'
}

DEFINE_CALL 'RGB_1PP_RELAX_TIMER_STOP'
{
		CALL 'SEKVENCE_0NP_RELAX_SVETLA_ZHASNOUT'
		RGB_1PP_RELAX_SEKVENCE = RGB_0RELAX_K_00
		KAMEN_RELAX_TIMER_ACTIVE=FALSE
		CANCEL_WAIT 'SEKVENCE_0NP_RELAX_WAIT'
		SEND_COMMAND dvMyTP_01,"'^TXT-51,0,','RGB OFF'"
		SEND_STRING 0,'TIMER RELAX STOP'
}

DEFINE_CALL 'SEKVENCE_0NP_RELAX_STOP'
{
	RGB_1PP_RELAX_01_ACTIVE = FALSE
	RGB_1PP_RELAX_02_ACTIVE = FALSE
	RGB_1PP_RELAX_03_ACTIVE = FALSE
	RGB_1PP_RELAX_04_ACTIVE = FALSE
	RGB_1PP_RELAX_05_ACTIVE = FALSE
	RGB_1PP_RELAX_SEKVENCE = RGB_0RELAX_K_00
	CALL 'RGB_1PP_RELAX_TIMER_STOP'  /// 
}

DEFINE_CALL 'SEKVENCE_0NP_RELAX_SVETLA_ZHASNOUT'	// Pouze krystal na stene
{
	CALL 'SEKVENCE_0NP_RELAX_KAMEN_RED_ZHASNOUT'
	WAIT 5
	CALL 'SEKVENCE_0NP_RELAX_KAMEN_GREEN_ZHASNOUT'
	WAIT 10
	CALL 'SEKVENCE_0NP_RELAX_KAMEN_BLUE_ZHASNOUT'
	WAIT 15
	CALL 'SEKVENCE_0NP_RELAX_KAMEN_WHITE_ZHASNOUT'		
}
DEFINE_CALL 'SEKVENCE_0NP_RELAX_KAMEN_RED_ZHASNOUT'
{
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_KAMEN_R01,0,00)	
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_KAMEN_R02,0,00)	 
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_KAMEN_R03,0,00)	
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_KAMEN_R04,0,00)	
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_KAMEN_R05,0,00)	 
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_KAMEN_R06,0,00)
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_KAMEN_R07,0,00)	
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_KAMEN_R08,0,00)	 
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_KAMEN_R09,0,00)
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_KAMEN_R10,0,00)	
}
DEFINE_CALL 'RGB_1PP_RELAX_KAMEN_RED_OFF'
{
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_KAMEN_R01,0,40)	
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_KAMEN_R02,0,40)	 
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_KAMEN_R03,0,40)	
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_KAMEN_R04,0,40)	
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_KAMEN_R05,0,40)	 

					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_DETSKY_05,100,3)							///	Zelena 
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_DETSKY_06,20,3)								///	Modra
				}
				CASE 8:
				{
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_DETSKY_04,00,3)								/// Cervena
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_DETSKY_05,80,3)								///	Zelena 
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_DETSKY_06,50,3)								///	Modra
				}
				CASE 9:
				{
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_DETSKY_04,00,3)								/// Cervena
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_DETSKY_05,70,3)								///	Zelena 
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_DETSKY_06,60,3)								///	Modra
				}
				CASE 10:
				{

					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_DETSKY_05,50,3)								///	Zelena 
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_DETSKY_06,70,3)								///	Modra
				}
				CASE 11:

DEFINE_CALL 'ZOBRAZ LEVEL_RELAX_KAMEN' (CHAR rChannel[], INTEGER rLevel)		// RELAX VELKY KAMEN
	{
	LOCAL_VAR INTEGER rTEMP
	LOCAL_VAR CHAR sTempLevel[5]
	IF ((rBUSSY = FALSE))
		{
		rBUSSY = TRUE
		rTEMP = (rLevel)
		sTempLevel = ITOA(rLevel)
		}
	ELSE
		{
		WAIT 10 'LEVEL_KAMEN'
		rBUSSY = FALSE
		rTEMP = (000)
		}
	SWITCH (rChannel)
			{
			CASE 'CH001':
				{
				SEND_COMMAND dvMyTP_01,"'^TXT-500,0,',sTempLevel"	// zmena
				SEND_LEVEL dvMyTP_01,500,TYPE_CAST(rTEMP)
				RED_TEMP = TYPE_CAST(rTEMP)
				rBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_KAMEN'
				//SEND_STRING 0,"'A35 Ch01'" 
				}
			CASE 'CH002':
				{

DEFINE_CALL 'ZOBRAZ LEVEL_DETPOKOJ' (CHAR rChannel[], INTEGER rLevel)		// TEST PRO DETSKY POKOJ
	{
	LOCAL_VAR CHAR dBUSSY  // CEKACKA 
	LOCAL_VAR INTEGER dTEMP  // PRO NEUKLADANE HODNOTY
	IF ((dBUSSY = TRUE))
		{
		WAIT 5 'LEVEL_DETPOKOJ'
		dBUSSY = FALSE
		dTEMP = (000)
		SEND_STRING 0,"'A22 BUSSY'"   /// JENOM PRO TESTY
		}
	ELSE
		{
		dBUSSY = TRUE
		dTEMP = (rLevel)
		}
	
	SWITCH (rChannel)
			{
			CASE 'CH001':    ///////////		DET POKOJ STROP STRED
				{
				SEND_COMMAND dvMyTP_01,"'^TXT-642,0,',ITOA(rLevel)"
				SEND_LEVEL dvMyTP_01,65,dTEMP
				dBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_DETPOKOJ'
				}
			CASE 'CH002':    ///////////		SIKMINA VLEVO 1
				{
				SEND_COMMAND dvMyTP_01,"'^TXT-641,0,',ITOA(rLevel)"
				SEND_LEVEL dvMyTP_01,65,dTEMP
				dBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_DETPOKOJ'
				}
			CASE 'CH003':    ///////////		SIKMINA VPRAVO 1
				{
				//SEND_COMMAND dvMyTP_01,"'^TXT-641,0,',ITOA(rLevel)"
				//SEND_LEVEL dvMyTP_01,65,dTEMP
				dBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_DETPOKOJ'
				}
			CASE 'CH004':    ///////////		DET POKOJ OKNO CERVENA
				{
				SEND_COMMAND dvMyTP_01,"'^TXT-46,0,',ITOA(rLevel)"
				SEND_LEVEL dvMyTP_01,18,dTEMP
				dBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_DETPOKOJ'
				}
			CASE 'CH005':    ///////////		DET POKOJ OKNO ZELENA
				{
				SEND_COMMAND dvMyTP_01,"'^TXT-47,0,',ITOA(rLevel)"
				SEND_LEVEL dvMyTP_01,19,dTEMP
				dBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_DETPOKOJ'
				}
			CASE 'CH006':    ///////////		DET POKOJ OKNO MODRA
				{
				rL1_UROVEN = (dTEMP)
				SEND_COMMAND dvMyTP_01,"'^TXT-48,0,',ITOA(dTEMP)"	//0-100
				SEND_LEVEL dvMyTP_01,20,dTEMP
				dBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_DETPOKOJ'
				}
			CASE 'CH007':    ///////////		DET POKOJ REZERVA?
				{
				//SEND_COMMAND dvMyTP_01,"'^TXT-642,0,',ITOA(rLevel)"
				//SEND_LEVEL dvMyTP_01,65,dTEMP
				dBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_DETPOKOJ'
				}
			CASE 'CH008':    ///////////		DET POKOJ REZERVA?
				{
				//SEND_COMMAND dvMyTP_01,"'^TXT-642,0,',ITOA(rLevel)"
				//SEND_LEVEL dvMyTP_01,65,dTEMP
				dBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_DETPOKOJ'
				}
			CASE 'CH009':    ///////////		DET POKOJ REZERVA?
				{
				//SEND_COMMAND dvMyTP_01,"'^TXT-642,0,',ITOA(rLevel)"
				//SEND_LEVEL dvMyTP_01,65,dTEMP
				dBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_DETPOKOJ'
				}
			CASE 'CH010':    ///////////		SIKMINA VLEVO 2
				{
				//SEND_COMMAND dvMyTP_01,"'^TXT-642,0,',ITOA(rLevel)"
				//SEND_LEVEL dvMyTP_01,65,dTEMP
				dBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_DETPOKOJ'
				}
			CASE 'CH011':    ///////////		SIKMINA VPRAVO 2 
				{
				//SEND_COMMAND dvMyTP_01,"'^TXT-642,0,',ITOA(rLevel)"
				//SEND_LEVEL dvMyTP_01,65,dTEMP
				dBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_DETPOKOJ'
				}
			}
	SEND_STRING 0,"'DET POKOJ CHANNEL: <',rChannel,'> -- <',ITOA(rChannel),'>'"   /// JENOM PRO TESTY
	}
DEFINE_CALL 'ZOBRAZ LEVEL_KUCHYN_1NP' (CHAR rChannel[], INTEGER rLevel)	// KUCHYN 1NP
	{
	LOCAL_VAR CHAR dBUSSY  // CEKACKA 
	LOCAL_VAR INTEGER dTEMP  // PRO NEUKLADANE HODNOTY
	IF ((dBUSSY = TRUE))
		{
		WAIT 5 'LEVEL_KUCHYN'
		dBUSSY = FALSE
		dTEMP = (000)
		SEND_STRING 0,"'A11 BUSSY'"   /// JENOM PRO TESTY
		}
	ELSE
		{
		dBUSSY = TRUE
		dTEMP = (rLevel)
		}
	
	SWITCH (rChannel)
			{
			CASE 'CH001':    ///////////		KUCHYN  SVETLA STROP
				{
				IF (dTEMP>70)
					{
					ON [dvMyTP_01,958]
					OFF [dvMyTP_01,959]
					}
				ELSE
					{
					OFF [dvMyTP_01,958]
					ON [dvMyTP_01,959]
					}
				dBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_KUCHYN'
				}
			CASE 'CH005':    ///////////	NAD SPORAKEM	
				{
				IF (dTEMP>70)
					{
					ON [dvMyTP_01,960]
					OFF [dvMyTP_01,961]
					}
				ELSE
					{
					OFF [dvMyTP_01,960]
					ON [dvMyTP_01,961]
					}
				dBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_KUCHYN'
				}
			CASE 'CH006':    ///////////	*LED LINKA VSTUP LEVA
				{
				IF (dTEMP>70)
					{
					ON [dvMyTP_01,962]
					OFF [dvMyTP_01,963]
					}
				ELSE
					{
					OFF [dvMyTP_01,962]
					ON [dvMyTP_01,963]
					}
				dBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_KUCHYN'
				}
			CASE 'CH007':    ///////////		LED SKRIN STRED
				{
				//SEND_COMMAND dvMyTP_01,"'^TXT-46,0,',ITOA(rLevel)"
				//SEND_LEVEL dvMyTP_01,18,dTEMP
				IF (dTEMP>70)
					{
					ON [dvMyTP_01,964]
					OFF [dvMyTP_01,965]
					}
				ELSE
					{
					OFF [dvMyTP_01,964]
					ON [dvMyTP_01,965]
					}
				dBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_KUCHYN'
				}
			CASE 'CH008':    ///////////		LED SKRIN PRAVA 
				{
				IF (dTEMP>70)
					{
					ON [dvMyTP_01,966]
					OFF [dvMyTP_01,967]
					}
				ELSE
					{
					OFF [dvMyTP_01,966]
					ON [dvMyTP_01,967]
					}
				dBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_KUCHYN'
				}
			CASE 'CH009':    ///////////		LED PODLAHA
				{
				IF (dTEMP>70)
					{
					ON [dvMyTP_01,968]
					OFF [dvMyTP_01,969]
					}
				ELSE
					{
					OFF [dvMyTP_01,968]
					ON [dvMyTP_01,969]
					}
				dBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_KUCHYN'
				}
			}
	SEND_STRING 0,"'KUCHYN CHANNEL: <',rChannel,'> -- <',ITOA(rChannel),'>'"   /// JENOM PRO TESTY
	}

			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_05,70,3)								///	Modra
		}
		CASE 11:
		{
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_03,00,3)								/// 	Cervena
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_04,00,3)								///	Zelena 
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_05,100,3)								///	Modra
		}
		CASE 12:
		{
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_03,20,3)								/// 	Cervena

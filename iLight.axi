DEFINE_CALL 'ZOBRAZ LEVEL_VIRIVKA' (CHAR rChannel[], INTEGER rLevel)		// RELAX VIRIVKA
	{
	//LOCAL_VAR CHAR rBUSSY  // CEKACKA Pridano nevim zde neni nekde nahore
	LOCAL_VAR INTEGER rTEMP  // NEUKLADAM PAC BYCH SE ZBLAZNIL
	IF ((rBUSSY = FALSE))
		{
		rBUSSY = TRUE
		rTEMP = (rLevel)
		}
	ELSE
		{
		WAIT 10 'LEVEL_VIRIVKA'
		rBUSSY = FALSE
		rTEMP = (000)
		//SEND_STRING 0,"'A03 BUSY'"   /// JENOM PRO TESTY
		}
	SEND_STRING 0,"'VIRIVKA CHANNEL: <',rChannel,'> LEVEL <',ITOA(rLevel),'>'"   /// JENOM PRO TESTY
	SWITCH (rChannel)

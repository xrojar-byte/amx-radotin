DEFINE_CALL 'REQUEST_CHANNELS_0NP_RELAX_GREEN'   // Kamen relax
{	 
	CALL 'ILIGHT_CHANNEL_REQUEST' (SV_1PP_RELAX_KAMEN_Z01)

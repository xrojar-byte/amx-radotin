/////////////////////////////////////////////////////////////////////////////////////////////////////////////////////
DEFINE_CALL 'RGB_2NP_LOZNICE_TIMER' (CHAR CAS)	// ZAKLADNI CASOVAC PRO 2NP LOZNICE - SEKVENCE V LOZNICE MUSI MIT STEJNOU DELKU
{
	RGB_2NP_LOZNICE_WAIT_TIME = CAS
	IF (RGB_2NP_LOZNICE_KROK > 14) 
		RGB_2NP_LOZNICE_KROK = 1
	IF (RGB_2NP_LOZNICE_TIMER_ACTIVE=TRUE)
		{
			SEND_STRING 0,'TIMER LOZNICE START'
			CALL 'SEKVENCE_2NP_LOZNICE_START'
			SEND_COMMAND dvMyTP_01,"'^TXT-52,0,','RGB 1 CASE ',ITOA(RGB_2NP_LOZNICE_KROK)"	
			SEND_LEVEL dvMyTP_01,150,RGB_2NP_LOZNICE_KROK*10 //  ASI BYCH ODSTRANIL, TEXT DLE MNE UPLNE STACI
			WAIT RGB_2NP_LOZNICE_WAIT_TIME 'SEKVENCE_2NP_LOZNICE_WAIT'
				{
				RGB_2NP_LOZNICE_KROK++
				CALL 'RGB_2NP_LOZNICE_TIMER' (CAS)
				}
		}
	 
}
	
DEFINE_CALL 'RGB_2NP_LOZNICE_TIMER_DOUBLE'  // CASOVAC PRO 2NP LOZNICE - SEKVENCE V LOZNICE MUSI MIT STEJNOU DELKU
{
	IF (RGB_2NP_LOZNICE_KROK > 20) 
		RGB_2NP_LOZNICE_KROK = 1
	IF (RGB_2NP_LOZNICE_TIMER_ACTIVE=TRUE)
		{
			//SEND_STRING 0,'TIMER LOZNICE START'
			CALL 'SEKVENCE_2NP_LOZNICE_START'
			SEND_COMMAND dvMyTP_01,"'^TXT-52,0,','RGB 1 CASE ',ITOA(RGB_2NP_LOZNICE_KROK)"	
			SEND_LEVEL dvMyTP_01,150,RGB_2NP_LOZNICE_KROK*10 //  ASI BYCH ODSTRANIL, TEXT DLE MNE UPLNE STACI
			WAIT 400 'SEKVENCE_2NP_LOZNICE_WAIT'
				{
				RGB_2NP_LOZNICE_KROK++
				CALL 'RGB_2NP_LOZNICE_TIMER_DOUBLE'
				}
		}
	 
}	
DEFINE_CALL 'SEKVENCE_2NP_LOZNICE_START'
{
    CALL 'SEKVENCE_2NP_LOZNICE_1'
	CALL 'SEKVENCE_2NP_LOZNICE_1B'
	CALL 'SEKVENCE_2NP_LOZNICE_2'
	CALL 'SEKVENCE_2NP_LOZNICE_2B'
	CALL 'SEKVENCE_2NP_LOZNICE_3'
	CALL 'SEKVENCE_2NP_LOZNICE_3B'
}

DEFINE_CALL 'RGB_2NP_LOZNICE_TIMER_STOP'
{
	IF ((RGB_2NP_LOZNICE_01_ACTIVE=FALSE) && (RGB_2NP_LOZNICE_02_ACTIVE=FALSE) && (RGB_2NP_LOZNICE_03_ACTIVE=FALSE) && (RGB_2NP_LOZNICE_01B_ACTIVE=FALSE) && (RGB_2NP_LOZNICE_02B_ACTIVE=FALSE) && (RGB_2NP_LOZNICE_03B_ACTIVE=FALSE))
		{
		CALL 'SEKVENCE_2NP_LOZNICE_SVETLA_ZHASNOUT'
		RGB_2NP_LOZNICE_SEKVENCE = RGB_2LOZ_00
		RGB_2NP_LOZNICE_TIMER_ACTIVE=FALSE
		CANCEL_WAIT 'SEKVENCE_2NP_LOZNICE_WAIT'
		SEND_COMMAND dvMyTP_01,"'^TXT-52,0,','RGB OFF'"
		SEND_STRING 0,'TIMER LOZNICE STOP'
		}
}

DEFINE_CALL 'SEKVENCE_2NP_LOZNICE_STOP'
{
	RGB_2NP_LOZNICE_01_ACTIVE = FALSE
	RGB_2NP_LOZNICE_01B_ACTIVE = FALSE
	RGB_2NP_LOZNICE_02_ACTIVE = FALSE
	RGB_2NP_LOZNICE_02B_ACTIVE = FALSE
	RGB_2NP_LOZNICE_03_ACTIVE = FALSE
	RGB_2NP_LOZNICE_03B_ACTIVE = FALSE
	RGB_2NP_LOZNICE_SEKVENCE = RGB_2LOZ_00
	//CALL 'RGB_2NP_LOZNICE_TIMER_STOP'  /// TADY BUDE MOZNA PROBLEM - ZHASNU SVETLA, ALE TY MOUHOU BYT JIZ NASTAVENA NEJAKOU SCENOU. BUD PONECHAM,NEBO PRIDAM VLASTNI STOP
}

DEFINE_CALL 'SEKVENCE_2NP_LOZNICE_SVETLA_ZHASNOUT'
{
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_10,00,0)								/// Cervena
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_11,00,0)								///	Zelena 
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_12,00,0)								///	Modra 
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_14,00,0)								/// Cervena
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_15,00,0)								///	Zelena 
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_16,00,0)
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_18,00,0)								/// Cervena
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_19,00,0)								///	Zelena 
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_20,00,0)
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_26,0,0)								///	Stud. bila
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_27,0,0)								///	Tepl. bila 
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_28,0,0)								///	Stud. bila
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_29,0,0)								///	Tepl. bila
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_30,0,0)								///	Stud. bila
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_31,0,0)								///	Tepl. bila
	CALL 'ILIGHT_SCENA' (ILT_2NP_LOZNICE_AREA,0)
}


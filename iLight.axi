DEFINE_CALL '1PP_RELAX_OBRAZ1_TIMER' (CHAR CAS)	// ZAKLADNI CASOVAC
{
	STM_KRB_PRAVA_WAIT_TIME = CAS	
	IF (STM_KRB_PRAVA_ON=TRUE)
		{
			SEND_STRING 0,'TIMER KRB PRAVA START'
			CALL 'SEKVENCE_1PP_RELAX_OBRAZ1_START'
			WAIT STM_KRB_PRAVA_WAIT_TIME 'STM_1PP_RELAX_OBRAZ1_WAIT'
				{
				STM_KRB_PRAVA_KROK++
				CALL 'REQUEST_CHANNELS_1NP_OBYVAK_KAMENY'
				CALL '1PP_RELAX_OBRAZ1_TIMER' (CAS)
				}
		}
	 
}

DEFINE_CALL 'SEKVENCE_1PP_RELAX_OBRAZ1_START'
{
	CALL 'SEKVENCE_1PP_RELAX_OBRAZ1_1'
	CALL 'SEKVENCE_1PP_RELAX_OBRAZ1_2'
	CALL 'SEKVENCE_1PP_RELAX_OBRAZ1_3'
	CALL 'SEKVENCE_1PP_RELAX_OBRAZ1_4'

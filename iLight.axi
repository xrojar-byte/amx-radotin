			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_04,50,3)								///	Zelena 
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_05,20,3)								///	Modra 
		}
		CASE 5:
		{
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_03,10,3)								/// 	Cervena
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_04,70,3)								///	Zelena 
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_05,20,3)								///	Modra
		}
		CASE 6:
		{
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_03,00,3)								/// 	Cervena
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_04,90,3)								///	Zelena 

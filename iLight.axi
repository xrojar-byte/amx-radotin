	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_09,00,0)								///	Zelena 
	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_10,00,0)								/// 	Cervena
	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_11,00,0)								///	Zelena 
	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_12,00,0)								///	Modra 
	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_13,00,0)								/// 	
	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_14,00,0)								/// 	Cervena
	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_15,00,0)								///	Zelena 
	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_16,00,0)
	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_17,00,0)								/// 	
	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_18,00,0)								/// 	Cervena
	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_19,00,0)								///	Zelena 
	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_20,00,0)
	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_21,00,0)								/// 	Cervena

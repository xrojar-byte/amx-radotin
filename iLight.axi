DEFINE_CALL 'SEKVENCE_0NP_RELAX_1'  // Premapovat na tlacitko a vymyslet bilou ob ciklus
{
IF (RGB_1PP_RELAX_SEKVENCE = RGB_0RELAX_K_01) 
		{
		CALL 'REQUEST_CHANNELS_0NP_RELAX_ALL'
		SWITCH (RGB_1PP_RELAX_KROK)
			{
				CASE 1:
				{
					CALL 'ALL_RED_0NP_RELAX_K_ON_60'
				}
				CASE 2:
				{
					CALL 'ALL_WHITE_0NP_RELAX_K_ON_90'
				}
				CASE 3:
				{
					CALL 'ALL_BLUE_0NP_RELAX_K_OFF_60'								//
				}
				CASE 4:
				{
					CALL 'ALL_GREEN_0NP_RELAX_K_ON_60'								//
				}
				CASE 5:
				{
					CALL 'ALL_RED_0NP_RELAX_K_OFF_60'								//
				}
				CASE 6:
				{
					CALL 'ALL_BLUE_0NP_RELAX_K_ON_60'							//
				}
				CASE 7:
				{
					CALL 'ALL_WHITE_0NP_RELAX_K_OFF_90'									//
				}
				CASE 8:
				{
					CALL 'ALL_GREEN_0NP_RELAX_K_OFF_60'								//
				}
				
			}
		IF (RGB_1PP_RELAX_KROK > 9) 
		RGB_1PP_RELAX_KROK = 1
		}
	ELSE	
		{
		SEND_STRING 0,'RGB 1 OFF'
		}
}

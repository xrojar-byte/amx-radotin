DEFINE_CALL 'POWER_OFF_0NP_RELAX_ALL'
    {
	CALL 'SEKVENCE_0NP_RELAX_SVETLA_ZHASNOUT'	// CHYBNY NAZEV - TOTO JE Pouze krystal na stene
	WAIT 10
	CALL 'SEKVENCE_0NP_RELAX_STOP'
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_01,0,10)
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_PODHLED_01,0,10)
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_PODHLED_02,0,10)
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_PODHLED_03,0,10)
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_PODHLED_04,0,10)
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_06,0,10)
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_07,0,10)
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_08,0,10)
	WAIT 44
	CALL 'POWER_OFF_0NP_VIRIVKA' 
	WAIT 79
	CALL 'POWER_OFF_0NP_RELAX_STENA_ALL' 
	WAIT 96
	CALL 'POWER_OFF_0NP_RELAX_SVETLIK'
	WAIT 113
	CALL 'POWER_OFF_0NP_KOUPELNA'
	WAIT 129
	CALL 'POWER_OFF_0NP_MANDALA'
	WAIT 150
	CALL 'POWER_OFF_0NP_ANG_DVORKY'
	WAIT 175
	CALL 'POWER_OFF_0NP_RELAX_RGB_ALL'
	WAIT 200
	CALL 'REQUEST_CHANNELS_0NP_RELAX_ALL'
	WAIT 270
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_UL_W01,0,10)
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_UL_C01,0,05)
	
    }
DEFINE_CALL 'RGB_2NP_HALA_TIMER' (CHAR CAS)	// ZAKLADNI CASOVAC PRO 2NP HALA - SEKVENCE V HALE MUSI MIT STEJNOU DELKU
{
	RGB_2NP_HALA_WAIT_TIME = CAS
	IF (RGB_2NP_HALA_KROK < 1) 
		RGB_2NP_HALA_KROK = 1
	IF (RGB_2NP_HALA_KROK > 20) 
		RGB_2NP_HALA_KROK = 1
	IF (RGB_2NP_HALA_TIMER_ACTIVE=TRUE)
		{
			SEND_STRING 0,'TIMER HALA START'
			CALL 'SEKVENCE_2NP_HALA_START'
			SEND_COMMAND dvMyTP_01,"'^TXT-51,0,','RGB ',ITOA(RGB_2NP_HALA_KROK)"
			SEND_LEVEL dvMyTP_01,153,RGB_2NP_HALA_KROK*5 // ASI BYCH ODSTRANIL, TEXT DLE MNE UPLNE STACI
			WAIT RGB_2NP_HALA_WAIT_TIME 'SEKVENCE_2NP_HALA_WAIT'
				{
				RGB_2NP_HALA_KROK++
				CALL 'RGB_2NP_HALA_TIMER' (CAS)
				}
		}
	 
}	

DEFINE_CALL 'RGB_2NP_HALA_TIMER_DOUBLE' // CASOVAC 2NP HALA zdvojeny natvrdo 400 - CHAR nebere vice nez 255
{
	IF (RGB_2NP_HALA_KROK < 1) 
		RGB_2NP_HALA_KROK = 1
	IF (RGB_2NP_HALA_KROK > 20) 
		RGB_2NP_HALA_KROK = 1
	IF (RGB_2NP_HALA_TIMER_ACTIVE=TRUE)
		{
			SEND_STRING 0,'TIMER HALA START'
			CALL 'SEKVENCE_2NP_HALA_START'
			SEND_COMMAND dvMyTP_01,"'^TXT-51,0,','RGB CASE ',ITOA(RGB_2NP_HALA_KROK)"
			SEND_LEVEL dvMyTP_01,153,RGB_2NP_HALA_KROK*0.5 // ASI BYCH ODSTRANIL, TEXT DLE MNE UPLNE STACI
			WAIT 400 'SEKVENCE_2NP_HALA_WAIT'
				{
				RGB_2NP_HALA_KROK++
				CALL 'RGB_2NP_HALA_TIMER_DOUBLE'
				}
		}
	 
}	

DEFINE_CALL 'SEKVENCE_2NP_HALA_START' //VYHOZENO AUTOMATICKE VYPNUTI A ZCELA PREDELANO
{	
		CALL 'SEKVENCE_2NP_HALA_1'
		CALL 'SEKVENCE_2NP_HALA_1B'
		CALL 'SEKVENCE_2NP_HALA_2'
		CALL 'SEKVENCE_2NP_HALA_2B'
		CALL 'SEKVENCE_2NP_HALA_3'
		CALL 'SEKVENCE_2NP_HALA_3B'
		CALL 'SEKVENCE_2NP_HALA_4'
		CALL 'SEKVENCE_2NP_HALA_4B'
		CALL 'SEKVENCE_2NP_HALA_5'
		CALL 'SEKVENCE_2NP_HALA_5B'
		//CALL 'SEKVENCE_2NP_HALA_6' // Angel nahoru
		//CALL 'SEKVENCE_2NP_HALA_7' // Angel pulse
		//CALL 'SEKVENCE_2NP_HALA_8'
		//CALL 'SEKVENCE_2NP_HALA_9'
		//CALL 'SEKVENCE_2NP_HALA_10'
		//CALL 'SEKVENCE_2NP_HALA_11'
}

DEFINE_CALL 'RGB_2NP_HALA_TIMER_STOP'
{
	IF ((RGB_2NP_HALA_01_ACTIVE=FALSE) && (RGB_2NP_HALA_02_ACTIVE=FALSE) && (RGB_2NP_HALA_03_ACTIVE=FALSE) && (RGB_2NP_HALA_04_ACTIVE=FALSE) && (RGB_2NP_HALA_05_ACTIVE=FALSE))
		{
		CALL 'SEKVENCE_2NP_HALA_SVETLA_ZHASNOUT'
		RGB_2NP_HALA_SEKVENCE = RGB_2HALA_00
		RGB_2NP_HALA_TIMER_ACTIVE=FALSE
		CANCEL_WAIT 'SEKVENCE_2NP_HALA_WAIT'
		SEND_COMMAND dvMyTP_01,"'^TXT-51,0,','RGB OFF'"
		SEND_STRING 0,'TIMER HALA STOP'
		SEND_LEVEL dvMyTP_01,153,0 // ASI BYCH ODSTRANIL, TEXT DLE MNE UPLNE STACI
		}
}
DEFINE_CALL 'SEKVENCE_2NP_HALA_STOP'
{
	RGB_2NP_HALA_01_ACTIVE = FALSE
	RGB_2NP_HALA_02_ACTIVE = FALSE
	RGB_2NP_HALA_03_ACTIVE = FALSE
	RGB_2NP_HALA_04_ACTIVE = FALSE
	RGB_2NP_HALA_05_ACTIVE = FALSE
	RGB_2NP_HALA_01B_ACTIVE = FALSE
	RGB_2NP_HALA_02B_ACTIVE = FALSE
	RGB_2NP_HALA_03B_ACTIVE = FALSE
	RGB_2NP_HALA_04B_ACTIVE = FALSE
	RGB_2NP_HALA_05B_ACTIVE = FALSE
	RGB_2NP_HALA_SEKVENCE = RGB_2HALA_00
	CALL 'RGB_2NP_HALA_TIMER_STOP'  /// TADY BUDE MOZNA PROBLEM - ZHASNU SVETLA, ALE TY MOUHOU BYT JIZ NASTAVENA NEJAKOU SCENOU. BUD PONECHAM,NEBO PRIDAM VLASTNI STOP
}


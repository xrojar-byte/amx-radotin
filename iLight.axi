			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_05,20,3)								///	Modra
		}
	}
	RGB_2NP_KOUPELNA_KROK++
	WAIT RGB_2NP_KOUPELNA_WAIT_TIME 'SEKVENCE_2NP_KOUPELNA_WAIT'
  	CALL 'SEKVENCE_2NP_KOUPELNA_1'

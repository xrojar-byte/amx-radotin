			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_18,0,3)								/// 	Cervena
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_19,0,3)								///	Zelena 
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_20,0,3)								///	Modra 
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_30,0,3)								///	Stud. bila
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_31,0,3)								///	Tepl. bila
			//SEND_STRING 0,'RGB 3 LOZNICE OFF'
			}
		}
}
DEFINE_CALL 'RGB_2NP_DETI_TIMER' (CHAR CAS)	// ZAKLADNI CASOVAC PRO 2NP DETI - SEKVENCE MUSI MIT STEJNOU DELKU
{
	LOCAL_VAR INTEGER iTIME_STOP
	RGB_2NP_DETI_WAIT_TIME = CAS
	iTIME_STOP=1
	IF (RGB_2NP_DETI_KROK > 14) 
		RGB_2NP_DETI_KROK = 1
	IF (RGB_2NP_DETI_TIMER_ACTIVE=TRUE)
		{
			SEND_STRING 0,'TIMER DETI START'
			CALL 'SEKVENCE_2NP_DETI_START'
			SEND_COMMAND dvMyTP_01,"'^TXT-51,0,','RGB CASE ',ITOA(RGB_2NP_DETI_KROK)"
			SEND_LEVEL dvMyTP_01,153,RGB_2NP_DETI_KROK*7.15 // ASI BYCH ODSTRANIL, TEXT DLE MNE UPLNE STACI
			WAIT RGB_2NP_DETI_WAIT_TIME 'SEKVENCE_2NP_DETI_WAIT'
				{
				RGB_2NP_DETI_KROK++
				iTIME_STOP++
				IF (iTIME_STOP<190)		/// VYPNE SE PO URCITE DOBE, 190 KROKU
					{
					CALL 'RGB_2NP_DETI_TIMER' (CAS)
					}
				ELSE
					{
					CALL 'SEKVENCE_2NP_DETI_STOP'
					//wait 15
					//CALL 'RGB_2NP_DETI_TIMER_STOP'
					}
				}
		}
	 
}	
DEFINE_CALL 'SEKVENCE_2NP_DETI_START'
{
	CALL 'SEKVENCE_2NP_DETI_1'
	//CALL 'SEKVENCE_2NP_DETI_2'
	//CALL 'SEKVENCE_2NP_DETI_3'
}

DEFINE_CALL 'RGB_2NP_DETI_TIMER_STOP'
{
	IF ((RGB_2NP_DETI_01_ACTIVE=FALSE) && (RGB_2NP_DETI_02_ACTIVE=FALSE) && (RGB_2NP_DETI_03_ACTIVE=FALSE) && (RGB_2NP_DETI_04_ACTIVE=FALSE) && (RGB_2NP_DETI_05_ACTIVE=FALSE))
		{
		CALL 'SEKVENCE_2NP_DETI_SVETLA_ZHASNOUT'
		RGB_2NP_DETI_SEKVENCE = RGB_2DET_00
		RGB_2NP_DETI_TIMER_ACTIVE=FALSE
		CANCEL_WAIT 'SEKVENCE_2NP_DETI_WAIT'
		SEND_COMMAND dvMyTP_01,"'^TXT-51,0,','RGB OFF'"
		SEND_STRING 0,'TIMER DETI STOP'
		CALL 'SEKVENCE_2NP_DETI_SVETLA_ZHASNOUT'  // Radeji pri ukonceni zhasnu, 
		}
}

DEFINE_CALL 'SEKVENCE_2NP_DETI_STOP'
{
	RGB_2NP_DETI_01_ACTIVE = FALSE
	RGB_2NP_DETI_02_ACTIVE = FALSE
	RGB_2NP_DETI_03_ACTIVE = FALSE
	RGB_2NP_DETI_04_ACTIVE = FALSE
	RGB_2NP_DETI_05_ACTIVE = FALSE
	RGB_2NP_DETI_SEKVENCE = RGB_2DET_00
	WAIT 6
	CALL 'RGB_2NP_DETI_TIMER_STOP'  /// TADY BUDE MOZNA PROBLEM - ZHASNU SVETLA, ALE TY MOUHOU BYT JIZ NASTAVENA NEJAKOU SCENOU. BUD PONECHAM,NEBO PRIDAM VLASTNI STOP
}

DEFINE_CALL 'SEKVENCE_2NP_DETI_SVETLA_ZHASNOUT' // RGB V OKNE
{
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_DETSKY_04,00,0)								/// Cervena
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_DETSKY_05,00,0)								///	Zelena 
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_DETSKY_06,00,0)								///	Modra 
}


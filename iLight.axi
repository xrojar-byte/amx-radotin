	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_04,00,0)								///	Modra 
	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_05,00,0)								/// 	Cervena
	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_06,00,0)
	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_07,00,0)

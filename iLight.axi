DEFINE_CALL '1NP_KRB_VSTREDU_TIMER' (CHAR CAS)	// ZAKLADNI CASOVAC
{
	STM_KRB_STRED_WAIT_TIME = CAS	
	IF (STM_KRB_STRED_ON=TRUE)
		{
			SEND_STRING 0,'TIMER KRB STRED START'
			CALL 'SEKVENCE_1NP_KRB_VSTREDU_START'
			WAIT STM_KRB_STRED_WAIT_TIME 'STM_1NP_KRB_VSTREDU_WAIT'
				{
				STM_KRB_STRED_KROK++
				CALL 'REQUEST_CHANNELS_1NP_OBYVAK_KAMENY'
				CALL '1NP_KRB_VSTREDU_TIMER' (CAS)
				}
		}
	 
}


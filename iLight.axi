			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_04,100,3)								///	Zelena 
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_05,20,3)								///	Modra
		}
		CASE 8:
		{
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_03,00,3)								/// 	Cervena
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_04,80,3)								///	Zelena 
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_05,50,3)								///	Modra
		}
		CASE 9:
		{
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_03,00,3)								/// 	Cervena
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_04,70,3)								///	Zelena 
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_05,60,3)								///	Modra
		}

DEFINE_CALL 'ZOBRAZ LEVEL_RELAX_STENA' (CHAR rChannel[], INTEGER rLevel)		//RELAX LAMPICKY NA ZDI + SVETLIK
	{
	LOCAL_VAR INTEGER rTEMP  // NEUKLADAM Prilis dat
	IF ((rBUSSY = FALSE))
		{
		rBUSSY = TRUE
		rTEMP = (rLevel)
		}
	ELSE
		{
		WAIT 10 'LEVEL_STENA'
		rBUSSY = FALSE
		rTEMP = (000)
		}
	SWITCH (rChannel)
			{
			CASE 'CH001':
				{
				SEND_COMMAND dvMyTP_01,"'^TXT-700,0,',ITOA(rLevel)"		// SVETLIK - PODHLED Cervena
				SEND_LEVEL dvMyTP_01,200,TYPE_CAST(rTEMP)
				RED_TEMP = TYPE_CAST(rTEMP)
				rBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_STENA'
				}
			CASE 'CH002':
				{
				SEND_COMMAND dvMyTP_01,"'^TXT-701,0,',ITOA(rLevel)"
				SEND_LEVEL dvMyTP_01,201,TYPE_CAST(rTEMP)
				WHITE_TEMP = TYPE_CAST(rTEMP)
				rBUSSY = FALSE
				CANCEL_WAIT 'LEVEL_STENA'
				// SEND_STRING 0,"'A38Ch02'"
				
				SEND_STRING 0,'BILA TEMP'
				}
			CASE 'CH003':
				{
				SEND_COMMAND dvMyTP_01,"'^TXT-702,0,',ITOA(rLevel)"
				SEND_LEVEL dvMyTP_01,202,TYPE_CAST(rTEMP)
				GREEN_TEMP = TYPE_CAST(rTEMP)
				rBUSSY = FALSE

	 CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_28,00,0)
}

DEFINE_CALL 'SEKVENCE_2NP_HALA_1'						/// Nad pohovkou
{
	IF (RGB_2NP_HALA_01_ACTIVE = TRUE) 
		{
		SEND_STRING 0,'RGB 1A ON'
		SEND_COMMAND dvMyTP_01,"'^TXT-810,0,','RGB ',ITOA(RGB_2NP_HALA_KROK)"
		SEND_LEVEL dvMyTP_01,154,RGB_2NP_HALA_KROK*5 // ASI BYCH ODSTRANIL, TEXT DLE MNE UPLNE STACI
		CALL 'REQUEST_CHANNELS_2NP_HALA_POHOVKA'
		SWITCH (RGB_2NP_HALA_KROK)
			{
			CASE 1:
				{
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_03,00,10)								/// Cervena
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_04,00,10)								///	Zelena 
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_HALA_05,00,15)								///	Modra 

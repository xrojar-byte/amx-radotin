DEFINE_CALL '1NP_KRB_VPRAVO_TIMER' (CHAR CAS)	// ZAKLADNI CASOVAC
{
	STM_KRB_PRAVA_WAIT_TIME = CAS	
	IF (STM_KRB_PRAVA_ON=TRUE)
		{
			SEND_STRING 0,'TIMER KRB PRAVA START'
			CALL 'SEKVENCE_1NP_KRB_VPRAVO_START'
			WAIT STM_KRB_PRAVA_WAIT_TIME 'STM_1NP_KRB_VPRAVO_WAIT'
				{
				STM_KRB_PRAVA_KROK++
				CALL 'REQUEST_CHANNELS_1NP_OBYVAK_KAMENY'
				CALL '1NP_KRB_VPRAVO_TIMER' (CAS)
				}
		}
	 
}


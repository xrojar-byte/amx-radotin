DEFINE_CALL 'ZOBRAZ SCENU' (CHAR ILT_MAM[]) // The syntax is: @RExx:Axx   RExx defines the Scene Number, valid for 00 to 99. Scene 00 is OFF. [cite_start]Axx defines the Area Number, valid for 01 to 99. [cite: 1814, 1815]
{
	LOCAL_VAR CHAR kSCENA[3]
	LOCAL_VAR CHAR kAREA[4]
	LOCAL_VAR INTEGER sSCENA // << OPRAVA ZDE
	STACK_VAR CHAR sTMP[10]
	STACK_VAR INTEGER nSCENA
	STACK_VAR INTEGER nAREA
	
	kSCENA = "ILT_MAM[2],ILT_MAM[3],ILT_MAM[4]"
	kAREA = "'A',ILT_MAM[6],ILT_MAM[7],ILT_MAM[8]"
	sSCENA = ATOI(kSCENA) 
	IF ((kAREA = 'A020'))		///////////		HALA
	{
		SEND_COMMAND dvMyTP_01,"'^TXT-51,0,',ITOA(sSCENA)"	//0-100
	}
	IF ((kAREA = 'A022'))		///////////		2NP DET POKOJ
	{
		SEND_COMMAND dvMyTP_01,"'^TXT-53,0,',ITOA(sSCENA)"	//0-100 [cite: 1817]
		IF (sSCENA >1)
				{
				SEND_STRING 0,"'DET POKOJ ZAPNUT!'"
				 IF (DET_POK_SV = 1)
					{
					CALL 'POWER_OFF_2NP_DET_POKOJ'
					}
		     }
	}
	IF ((kAREA = 'A023'))		///////////		2NP KOUPELNA [cite: 1818]
	{
		SEND_COMMAND dvMyTP_01,"'^TXT-54,0,',ITOA(sSCENA)"	//0-100
	}	 

	sTMP = ILT_MAM
	nSCENA = ATOI(sTMP) // :Axxx SE IGNORUJE [cite: 1819]
	REMOVE_STRING(sTMP,"':A'",1) // ODSTRANIM xxx:A, ZUSTAVA xxx
	nAREA = ATOI(sTMP)
	SWITCH (nAREA)
		{
		CASE ILT_2NP_LOZNICE_AREA:
			{
			 IF (RGB_2NP_LOZNICE_SEKVENCE = RGB_2LOZ_00)
				{
				 
				 IF (nSCENA = 0)
					  SEND_COMMAND dvMyTP_01,"'^TXT-52,0,','OFF'" // 0.SCENA = OFF
					ELSE
					  SEND_COMMAND dvMyTP_01,"'^TXT-52,0,',ITOA(nSCENA)"	// 1-100				 [cite: 1821]
				}
			}
		CASE ILT_1NP_OBYVAK1_AREA:
			{
				  IF (nSCENA = 0)
					  SEND_COMMAND dvMyTP_01,"'^TXT-60,0,','OFF'" // 0.SCENA = OFF
					ELSE
					  SEND_COMMAND dvMyTP_01,"'^TXT-60,0,',ITOA(nSCENA)"	// 1-100				 [cite: 1822]
			}
		CASE ILT_1NP_OBYVAK2_AREA:
			{
				  IF (nSCENA = 0)
					  SEND_COMMAND dvMyTP_01,"'^TXT-61,0,','OFF'" // 0.SCENA = OFF
					ELSE
					 SEND_COMMAND dvMyTP_01,"'^TXT-61,0,',ITOA(nSCENA)"	// 1-100				 [cite: 1823]
			}
		CASE ILT_0NP_RELAX_DVORKY_AREA:
			{
				  IF (nSCENA = 0)
					  SEND_COMMAND dvMyTP_01,"'^TXT-101,0,','OFF'" // 0.SCENA = OFF
					ELSE
					SEND_COMMAND dvMyTP_01,"'^TXT-101,0,',ITOA(nSCENA)"	// 1-100 [cite: 1824]
					  IF (sSCENA >0)
							{
								SEND_STRING 0,"'ANGL DVORKY ZAPNUTY!'"
								IF (DET_POK_SV = 1)
									{
									CALL 'POWER_OFF_0NP_ANG_DVORKY'
									}
							}
			}
		}	
}

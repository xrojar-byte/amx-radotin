DEFINE_START

DEFINE_EVENT

DATA_EVENT[dvIlight]
{
  ONLINE: 
	{
	  SEND_COMMAND dvIlight,"'SET BAUD 9600,N,8,1 485 DISABLE'"
		ILT_BUSY = FALSE
		ILT_QUEUE = ""
		ILT_BUFFER = ""
		WAIT 1900
		CALL 'ILIGHT_SCENA2'(0,22,1)
		//CALL 'VYPINACE_RESTART'
		IF (VYP_SVET=0)
			{
			IF (SV_Manual=0)
			    {
			    //CALL 'ALL_SVETLA_OFF'
			    }
			}
		WAIT 3900
		CALL 'ILIGHT_SCENA2'(00,22,00)
	}
	STRING: 
	{
	  ILT_BUFFER = "ILT_BUFFER,DATA.TEXT"
		CALL 'ILIGHT_BUFFER_PROCESS'
	}
}

DEFINE_PROGRAM

IF (LENGTH_STRING(ILT_QUEUE))  (* WE HAVE SOMETHING TO SEND *)
    {
    IF (!(ILT_BUSY))
	   CALL 'SEND_TO_ILIGHT_PORT'
    }
	 

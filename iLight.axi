					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_DETSKY_05,00,3)								///	Zelena 
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_DETSKY_06,100,3)							///	Modra
				}
				CASE 12:
				{
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_DETSKY_04,20,3)								/// Cervena

DEFINE_CALL 'RGB_2NP_VRETENO_TIMER' // ZAKLADNI CASOVAC PRO VRETENO
{
	IF (RGB_2NP_VRETENO_KROK > 12) 
		RGB_2NP_VRETENO_KROK = 1
	IF (RGB_2NP_VRETENO_MOD > 0 )
		{
			CALL 'SEKVENCE_2NP_VRETENO_START'
			//SEND_STRING 0,'TIMER HEART KROK'
			WAIT RGB_2NP_VRETENO_WAIT_TIME 'EFEKT_2NP_VRETENO'
				{
				RGB_2NP_VRETENO_KROK++
				CALL 'RGB_2NP_VRETENO_TIMER'
				}
		}
	 
}

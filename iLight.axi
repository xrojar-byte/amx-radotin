		  SEND_LEVEL dvMyTP_01,25,r02_2KP_UROVEN
		  }
	 ELSE IF ((kCHANNEL_AREA = 'CH004:A023'))			
		  {
		  g02_2KP_UROVEN = (sLEVEL)
		  SEND_COMMAND dvMyTP_01,"'^TXT-119,0,',ITOA(sLEVEL)"
		  SEND_LEVEL dvMyTP_01,26,g02_2KP_UROVEN 
		  }
	 ELSE IF ((kCHANNEL_AREA = 'CH005:A023'))
		  {
		  b02_2KP_UROVEN = (sLEVEL)

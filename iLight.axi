DEFINE_CALL 'SEKVENCE_2NP_KOUPELNA_START' (CHAR CISLO_SEKVENCE, CHAR CAS)
{	
	RGB_2NP_KOUPELNA_WAIT_TIME = CAS
  IF (RGB_2NP_KOUPELNA_SEKVENCE<>CISLO_SEKVENCE) // JINA NEZ AKTUALNI SEKVENCE - PAK ZASTAVIM AKTUALNI A NASTAVIM VSE PRO START NOVE 
	{
	  CALL 'SEKVENCE_2NP_KOUPELNA_STOP'
		// JELIKOZ STARTUJE NOVA SEKVENCE, ZHASNU TAKE SVETLA, KTERA JSOU SOUCASTI SEKVENCE
		CALL 'SEKVENCE_2NP_KOUPELNA_SVETLA_ZHASNOUT'
		RGB_2NP_KOUPELNA_SEKVENCE = CISLO_SEKVENCE
		RGB_2NP_KOUPELNA_KROK = 1
	} 
	ELSE 
	{
	  // STEJNA SEKVENCE, PAK VYVOLAM IHNED DALSI KROK - BEZ CEKACKY
		CANCEL_WAIT 'SEKVENCE_2NP_KOUPELNA_WAIT'
	}
	SWITCH (RGB_2NP_KOUPELNA_SEKVENCE)
	{
		CASE RGB_2KOUP_01: CALL 'SEKVENCE_2NP_KOUPELNA_1'
		CASE RGB_2KOUP_02: CALL 'SEKVENCE_2NP_KOUPELNA_2'
		CASE RGB_2KOUP_03: CALL 'SEKVENCE_2NP_KOUPELNA_3'
		CASE RGB_2KOUP_04: CALL 'SEKVENCE_2NP_KOUPELNA_4'
		CASE RGB_2KOUP_05: CALL 'SEKVENCE_2NP_KOUPELNA_5'
		CASE RGB_2KOUP_06: CALL 'SEKVENCE_2NP_KOUPELNA_6'
		DEFAULT: RGB_2NP_KOUPELNA_SEKVENCE = RGB_2KOUP_00 // JEN PRO JISTOTU, KDYBY SE VOLALO NEEXISTUJICI CISLO SEKVENCE
	}
}
DEFINE_CALL 'SEKVENCE_2NP_KOUPELNA_STOP'
{
	CANCEL_WAIT 'SEKVENCE_2NP_KOUPELNA_WAIT'
	RGB_2NP_KOUPELNA_SEKVENCE = RGB_2KOUP_00
	SEND_COMMAND dvMyTP_01,"'^TXT-54,0,','RGB OFF'"
	CALL 'SEKVENCE_2NP_KOUPELNA_SVETLA_ZHASNOUT'
}
DEFINE_CALL 'SEKVENCE_2NP_KOUPELNA_SVETLA_ZHASNOUT'
{
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_01,00,0)								/// 	
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_02,00,0)								/// 	
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_03,00,0)								///	
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_04,00,0)								/// 	
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_05,00,0)								///	 
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_06,00,0)								///	
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_07,00,0)								/// 	
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_08,00,0)								///	
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_09,00,0)								/// 	
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_10,00,0)								///	 
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_11,00,0)								///
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_12,00,0)								///	
}

DEFINE_CALL 'SEKVENCE_2NP_KOUPELNA_1'
{
  IF (RGB_2NP_KOUPELNA_KROK > 14) 
	  RGB_2NP_KOUPELNA_KROK = 1
	SEND_COMMAND dvMyTP_01,"'^TXT-54,0,','RGB 1 CASE ',ITOA(RGB_2NP_KOUPELNA_KROK)"	
	SEND_LEVEL dvMyTP_01,152,RGB_2NP_KOUPELNA_KROK*7.15 // POKUD BUDOU MIT SEKVENCE RUZNOU DELKU, NEBUDE TENTO UKAZATEL MOC FUNGOVAT - ASI BYCH ODSTRANIL, TEXT DLE MNE UPLNE STACI
	SWITCH (RGB_2NP_KOUPELNA_KROK)
	{
		CASE 1:
		{
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_03,100,3)								/// 	Cervena
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_04,0,3)								///	Zelena 

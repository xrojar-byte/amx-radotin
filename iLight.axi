////////////////////////////////////////////////////
DEFINE_CALL 'ZOBRAZ LEVEL' (CHAR ILT_MAM[])					//  ZOBRAZENI UROVNE PRO SVETLA
{
    LOCAL_VAR CHAR kLEVEL[4] // Zvetšeno pro bezpecné uložení 3 císlic + null terminator
    LOCAL_VAR CHAR kCHANNEL_AREA[10]
    LOCAL_VAR CHAR kCHANNEL[5]
    LOCAL_VAR CHAR kAREA[5]
    LOCAL_VAR INTEGER sLEVEL // << OPRAVA 1: Zmena datového typu z CHAR na INTEGER

    LOCAL_VAR INTEGER uTEMP  // PRO NEUKLADANE HODNOTY
	LOCAL_VAR INTEGER aTEMP  // PRO Test
	LOCAL_VAR INTEGER bTEMP  // PRO Test

	// << OPRAVA 2: Použití jednoduchých uvozovek pro správné sestavení stringu
	kLEVEL = "'',ILT_MAM[11],ILT_MAM[12],ILT_MAM[13]"
	kCHANNEL_AREA = "'CH',ILT_MAM[1],ILT_MAM[2],ILT_MAM[3],':A',ILT_MAM[6],ILT_MAM[7],ILT_MAM[8]"
	kCHANNEL = "'CH',ILT_MAM[1],ILT_MAM[2],ILT_MAM[3]"
	kAREA = "'A',ILT_MAM[6],ILT_MAM[7],ILT_MAM[8]"

	sLEVEL = ATOI(kLEVEL) // Nyní se INTEGER ukládá do INTEGER promenné

	// SEND_STRING 0,"'AREA:<',kAREA,'> CHANNEL<',kCHANNEL,'> LEVEL:<',ITOA(sLEVEL),'>'"   /// Puvodní testovací rádek upraven pro INTEGER sLEVEL

	IF ((kAREA == 'A035'))
		{
		CALL 'ZOBRAZ LEVEL_RELAX_KAMEN' (kCHANNEL,sLEVEL)
		}
	ELSE IF ((kAREA == 'A040'))
		{
		CALL 'ZOBRAZ LEVEL_RELAX_NORMAL' (kCHANNEL,sLEVEL)
		}
	ELSE IF ((kAREA == 'A038'))
		{
		CALL 'ZOBRAZ LEVEL_RELAX_STENA' (kCHANNEL,sLEVEL)
		}
	ELSE IF ((kAREA == 'A039'))
		{
		CALL 'ZOBRAZ LEVEL_RELAX_KOUPEL' (kCHANNEL,sLEVEL)
		}
	ELSE IF ((kAREA == 'A021'))
		{
		CALL 'ZOBRAZ LEVEL_LOZNICE' (kCHANNEL,sLEVEL)
		}
	ELSE IF ((kAREA == 'A022'))
		{
		CALL 'ZOBRAZ LEVEL_DETPOKOJ' (kCHANNEL,sLEVEL)
		}
	ELSE IF ((kAREA == 'A031'))
		{
		CALL 'ZOBRAZ LEVEL_AN_DVORKY' (kCHANNEL,sLEVEL)
		}
	ELSE IF ((kAREA == 'A049'))
		{
		CALL 'ZOBRAZ LEVEL_VIRIVKA' (kCHANNEL,sLEVEL)
		}
	ELSE IF ((kAREA == 'A011'))
		{
		CALL 'ZOBRAZ LEVEL_KUCHYN_1NP' (kCHANNEL,sLEVEL)
		}
	 ELSE IF ((kCHANNEL_AREA = 'CH006:A023'))		///////////		2NP Koupelna RGB 1
		  {
		  r01_2KP_UROVEN = (sLEVEL)
		  SEND_COMMAND dvMyTP_01,"'^TXT-114,0,',ITOA(sLEVEL)"	//0-100
		  SEND_LEVEL dvMyTP_01,21,r01_2KP_UROVEN
		  }
	 ELSE IF ((kCHANNEL_AREA = 'CH007:A023'))			
		  {
		  g01_2KP_UROVEN = (sLEVEL)
		  SEND_COMMAND dvMyTP_01,"'^TXT-115,0,',ITOA(sLEVEL)"
		  SEND_LEVEL dvMyTP_01,22,g01_2KP_UROVEN
		  }
	 ELSE IF ((kCHANNEL_AREA = 'CH008:A023'))
		  {
		  b01_2KP_UROVEN = (sLEVEL)
		  SEND_COMMAND dvMyTP_01,"'^TXT-116,0,',ITOA(sLEVEL)"
		  SEND_LEVEL dvMyTP_01,23,b01_2KP_UROVEN
		  }
	 ELSE IF ((kCHANNEL_AREA = 'CH003:A023'))		///////////		2NP Koupelna RGB 2
		  {
		  r02_2KP_UROVEN = (sLEVEL)

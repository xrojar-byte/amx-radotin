(*
DEFINE_CALL 'RGB_1PP_RELAX_TIMER' (CHAR CAS)	// KOSTRA PRO POUZITI
{
	RGB_1PP_RELAX_WAIT_TIME = CAS
	IF (RGB_1PP_RELAX_KROK < 1) 
		RGB_1PP_RELAX_KROK = 1
	IF (RGB_1PP_RELAX_KROK > 20) 
		RGB_1PP_RELAX_KROK = 1
	IF (RGB_1PP_RELAX_TIMER_ACTIVE=TRUE)
		{
			SEND_STRING 0,'TIMER RELAX START'
			CALL 'SEKVENCE_1PP_RELAX_START'
			SEND_COMMAND dvMyTP_01,"'^TXT-51,0,','RGB ',ITOA(RGB_1PP_RELAX_KROK)"
			SEND_LEVEL dvMyTP_01,153,RGB_1PP_RELAX_KROK*5 // ASI BYCH ODSTRANIL, TEXT DLE MNE UPLNE STACI
			WAIT RGB_1PP_RELAX_WAIT_TIME 'SEKVENCE_1PP_RELAX_WAIT'
				{
				RGB_1PP_RELAX_KROK++
				CALL 'RGB_1PP_RELAX_TIMER' (CAS)
				}
		}
	 
}	

DEFINE_CALL 'RGB_1PP_RELAX_TIMER_DOUBLE' // CASOVAC 2NP HALA zdvojeny natvrdo 400 - CHAR nebere vice nez 255
{
	IF (RGB_1PP_RELAX_KROK < 1) 
		RGB_1PP_RELAX_KROK = 1
	IF (RGB_1PP_RELAX_KROK > 20) 
		RGB_1PP_RELAX_KROK = 1
	IF (RGB_1PP_RELAX_TIMER_ACTIVE=TRUE)
		{
			SEND_STRING 0,'TIMER HALA START'
			CALL 'SEKVENCE_1PP_RELAX_START'
			SEND_COMMAND dvMyTP_01,"'^TXT-51,0,','RGB CASE ',ITOA(RGB_1PP_RELAX_KROK)"
			SEND_LEVEL dvMyTP_01,153,RGB_1PP_RELAX_KROK*0.5 // ASI BYCH ODSTRANIL, TEXT DLE MNE UPLNE STACI
			WAIT 400 'SEKVENCE_1PP_RELAX_WAIT'
				{
				RGB_1PP_RELAX_KROK++
				CALL 'RGB_1PP_RELAX_TIMER_DOUBLE'
				}
		}
	 
}	

DEFINE_CALL 'SEKVENCE_1PP_RELAX_START' //VYHOZENO AUTOMATICKE VYPNUTI A ZCELA PREDELANO
{	
		CALL 'SEKVENCE_1PP_RELAX_1'
		CALL 'SEKVENCE_1PP_RELAX_1B'
		CALL 'SEKVENCE_1PP_RELAX_2'
		CALL 'SEKVENCE_1PP_RELAX_2B'
		CALL 'SEKVENCE_1PP_RELAX_3'
		CALL 'SEKVENCE_1PP_RELAX_3B'
		CALL 'SEKVENCE_1PP_RELAX_4'
		CALL 'SEKVENCE_1PP_RELAX_4B'
		CALL 'SEKVENCE_1PP_RELAX_5'
		CALL 'SEKVENCE_1PP_RELAX_5B'
		//CALL 'SEKVENCE_1PP_RELAX_6' // Angel nahoru
		//CALL 'SEKVENCE_1PP_RELAX_7' // Angel pulse
		//CALL 'SEKVENCE_1PP_RELAX_8'
		//CALL 'SEKVENCE_1PP_RELAX_9'
		//CALL 'SEKVENCE_1PP_RELAX_10'
		//CALL 'SEKVENCE_1PP_RELAX_11'
}

DEFINE_CALL 'RGB_1PP_RELAX_TIMER_STOP'
{
	IF ((RGB_1PP_RELAX_01_ACTIVE=FALSE) && (RGB_1PP_RELAX_02_ACTIVE=FALSE) && (RGB_1PP_RELAX_03_ACTIVE=FALSE) && (RGB_1PP_RELAX_04_ACTIVE=FALSE) && (RGB_1PP_RELAX_05_ACTIVE=FALSE))
		{
		CALL 'SEKVENCE_1PP_RELAX_SVETLA_ZHASNOUT'
		RGB_1PP_RELAX_SEKVENCE = RGB_2HALA_00
		RGB_1PP_RELAX_TIMER_ACTIVE=FALSE
		CANCEL_WAIT 'SEKVENCE_1PP_RELAX_WAIT'
		SEND_COMMAND dvMyTP_01,"'^TXT-51,0,','RGB OFF'"
		SEND_STRING 0,'TIMER HALA STOP'
		SEND_LEVEL dvMyTP_01,153,0 // ASI BYCH ODSTRANIL, TEXT DLE MNE UPLNE STACI
		}
}
DEFINE_CALL 'SEKVENCE_1PP_RELAX_STOP'
{
	RGB_1PP_RELAX_01_ACTIVE = FALSE
	RGB_1PP_RELAX_02_ACTIVE = FALSE
	RGB_1PP_RELAX_03_ACTIVE = FALSE
	RGB_1PP_RELAX_04_ACTIVE = FALSE
	RGB_1PP_RELAX_05_ACTIVE = FALSE
	RGB_1PP_RELAX_01B_ACTIVE = FALSE
	RGB_1PP_RELAX_02B_ACTIVE = FALSE
	RGB_1PP_RELAX_03B_ACTIVE = FALSE
	RGB_1PP_RELAX_04B_ACTIVE = FALSE
	RGB_1PP_RELAX_05B_ACTIVE = FALSE
	RGB_1PP_RELAX_SEKVENCE = RGB_2HALA_00
	CALL 'RGB_1PP_RELAX_TIMER_STOP'  /// TADY BUDE MOZNA PROBLEM - ZHASNU SVETLA, ALE TY MOUHOU BYT JIZ NASTAVENA NEJAKOU SCENOU. BUD PONECHAM,NEBO PRIDAM VLASTNI STOP
}


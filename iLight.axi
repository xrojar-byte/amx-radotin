DEFINE_CALL 'SEKVENCE_1NP_OBYVAK_STOP'
{
	RGB_1NP_OBYVAK_01_ACTIVE = FALSE
	RGB_1NP_OBYVAK_01B_ACTIVE = FALSE
	RGB_1NP_OBYVAK_MOD = RGB_1NP_OBYVAK_00
	BUDHA_1NP_OBYVAK_MOD=BUDHA_1NP_OBYVAK_00
	CANCEL_WAIT 'RGB_1NP_OBYVAK_WAIT'
	CALL 'ILIGHT_CHANNEL_OFF' (SV_1NP_OBYVAK_03)	
	WAIT 5
	CALL 'ILIGHT_CHANNEL_OFF' (SV_1NP_OBYVAK_12)
	SEND_COMMAND dvMyTP_01,"'^TXT-485,0,','RGB OFF'"
	SEND_LEVEL dvMyTP_01,485,0
	CALL 'SEKVENCE_1NP_OBYVAK_RGB_ZHASNOUT'
	WAIT 10
	CALL 'SEKVENCE_1NP_KRB_VPRAVO_STOP'
	WAIT 15
	CALL 'SEKVENCE_1NP_KRB_VSTREDU_STOP'
	WAIT 20
	CALL 'SEKVENCE_1NP_KRB_VLEVO_STOP'
	WAIT 30
	CALL 'REQUEST_CHANNELS_OBYVAK_RGB'
}

DEFINE_CALL 'SEKVENCE_1NP_OBYVAK_RGB_ZHASNOUT'
{
CALL 'ILIGHT_CHANNEL_VALUE' (SV_1NP_OBYVAK_04,00,0)								/// 	
CALL 'ILIGHT_CHANNEL_VALUE' (SV_1NP_OBYVAK_05,00,0)								///	
CALL 'ILIGHT_CHANNEL_VALUE' (SV_1NP_OBYVAK_06,00,0)							/// 	
CALL 'ILIGHT_CHANNEL_VALUE' (SV_1NP_OBYVAK_07,00,0)								///	 
CALL 'ILIGHT_CHANNEL_VALUE' (SV_1NP_OBYVAK_08,00,0)								///	
}


DEFINE_CALL 'EFEKT_SRDCE_TIMER' 	// CASOVAC PRO EFEKT SRDCE A STMIVANI
{
	SV_CAS1 = ITOA (EFEKT_SRDCE_WAIT1_TIME)
	SV_CAS2 = ITOA (EFEKT_SRDCE_WAIT2_TIME)
	SV_CAS3 = ITOA (EFEKT_SRDCE_WAIT3_TIME)
	SEND_STRING 0,"'Cas1 : <',SV_CAS1,'>'"   /// JENOM PRO TESTY
	SEND_STRING 0,"'Cas2 : <',SV_CAS2,'>'"   /// JENOM PRO TESTY
	SEND_STRING 0,"'Cas3 : <',SV_CAS3,'>'"   /// JENOM PRO TESTY
	IF (EFEKT_SRDCE_TIMER_ACTIVE)
		{
			CANCEL_WAIT 'OBYVAK_SRDCE3'
			EFEKT_SRDCE_KROK = 1
			CALL 'EFEKT_SRDCE_START'
			WAIT EFEKT_SRDCE_WAIT1_TIME
				{
				EFEKT_SRDCE_KROK = 2
				CALL 'EFEKT_SRDCE_START'
				WAIT EFEKT_SRDCE_WAIT2_TIME
					{
					EFEKT_SRDCE_KROK = 3
					CALL 'EFEKT_SRDCE_START'
					WAIT EFEKT_SRDCE_WAIT3_TIME 'OBYVAK_SRDCE3'
					CALL 'EFEKT_SRDCE_TIMER' 
					}
				}
		}
	SEND_COMMAND dvMyTP_01,"'^TXT-100,0,',SV_CAS3"
	///WAIT 5
	///SEND_COMMAND dvMyTP_01,"'^TXT-100,0,',EFEKT_SRDCE_WAIT3_TIME"
}

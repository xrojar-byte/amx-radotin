DEFINE_CALL '1NP_KRB_VLEVO_TIMER' (CHAR CAS)	// ZAKLADNI CASOVAC
{
	STM_KRB_LEVA_WAIT_TIME = CAS	
	IF (STM_KRB_LEVA_ON=TRUE)
		{
			SEND_STRING 0,'TIMER KRB LEVA START'
			CALL 'SEKVENCE_1NP_KRB_VLEVO_START'
			//SEND_COMMAND dvMyTP_01,"'^TXT-51,0,','RGB CASE ',ITOA(RGB_2NP_DETI_KROK)"
			//SEND_LEVEL dvMyTP_01,153,RGB_2NP_DETI_KROK*7.15 // ASI BYCH ODSTRANIL, TEXT DLE MNE UPLNE STACI
			WAIT STM_KRB_LEVA_WAIT_TIME 'STM_1NP_KRB_VLEVO_WAIT'
				{
				STM_KRB_LEVA_KROK++
				CALL 'REQUEST_CHANNELS_1NP_OBYVAK_KAMENY'
				CALL '1NP_KRB_VLEVO_TIMER' (CAS)
				}
		}
	 
}


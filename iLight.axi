				CASE 8:
				{
					CALL 'RGB_1PP_RELAX_KAMEN_BLUE_OFF'							//
				}
				CASE 9:
				{
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_KAMEN_B09,100,60)								//
				}
				CASE 10:
				{
					CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_KAMEN_B10,100,60)								//
				}
				CASE 11:
				{
					WAIT 600
					CALL 'RGB_1PP_RELAX_TIMER_STOP'		//Stacilo
				}
			}
		}
	ELSE	
		{
		SEND_STRING 0,'RGB 1 OFF'
		}
}

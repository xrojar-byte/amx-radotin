DEFINE_CALL 'SEKVENCE_1PP_RELAX_1'						/// Nad pohovkou
{
	IF (RGB_1PP_RELAX_01_ACTIVE = TRUE) 
		{
		SEND_STRING 0,'RGB 1A ON'
		SEND_COMMAND dvMyTP_01,"'^TXT-810,0,','RGB ',ITOA(RGB_1PP_RELAX_KROK)"
		SEND_LEVEL dvMyTP_01,154,RGB_1PP_RELAX_KROK*5 // ASI BYCH ODSTRANIL, TEXT DLE MNE UPLNE STACI
		CALL 'REQUEST_CHANNELS_1PP_RELAX_POHOVKA'
		SWITCH (RGB_1PP_RELAX_KROK)
			{
			CASE 1:
				{
				CALL 'ILIGHT_CHANNEL_VALUE' (SV_1PP_RELAX_03,00,10)								/// Cervena

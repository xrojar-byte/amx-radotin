			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_04,40,3)								///	Zelena 
			CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_KOUPELNA_05,20,3)								///	Modra

DEFINE_CALL 'EFEKT_SRDCE_START'
{
	IF (CAS_SRDCE_KROK > 2) 
		CAS_SRDCE_KROK = 1
	CALL 'SEQ_SRDCE_OBYVAK_1'
	CALL 'SEQ_SRDCE_OBYVAK_2'
	CALL 'SEQ_SRDCE_CHOD_VRETENO'
	CALL 'SEQ_SRDCE_LOZNICE_ANGEL'
	CALL 'SEQ_SRDCE_RELAX_KAMEN'
}
DEFINE_CALL 'EFEKT_SRDCE_STOP'
{
	SQ_OBYV_KAM_STRED=OB_1NP_KSTRED_00
	SQ_OBYV_KAM_PRAVA=OB_1NP_KPRAVA_00
	SQ_CHOD_VRETENO = CH_2NP_VRETENO_00
	SQ_RELAX_SRDCE = REL_0NP_SRDCE_00
	CAS_SRDCE_KROK = 0
}
DEFINE_CALL 'SEQ_SRDCE_OBYVAK_1'
{
	IF (SQ_OBYV_KAM_STRED >0)		////// OBYVAK KRB STRED TEPLA LED		
		  {
		  SWITCH (SQ_OBYV_KAM_STRED)
			{
			CASE OB_1NP_KSTRED_01:
				{
				CALL 'SEQ_KAM_STRED_1'
				}
			CASE OB_1NP_KSTRED_02:
				{
				CALL 'SEQ_KAM_STRED_2'
				}
			CASE OB_1NP_KSTRED_03:
				{
				CALL 'SEQ_KAM_STRED_3'
				}
			CASE OB_1NP_KSTRED_04:
				{
				CALL 'SEQ_KAM_STRED_4'
				}
			}
		}
}
DEFINE_CALL 'SEQ_SRDCE_OBYVAK_2'
{
	IF (SQ_OBYV_KAM_PRAVA >0)		////// OBYVAK KRB PRAVA TEPLA LED		
		  {
		  SWITCH (SQ_OBYV_KAM_PRAVA)
			{
			CASE OB_1NP_KPRAVA_01:
				{
				CALL 'SEQ_KAM_PRAVA_1'
				}
			CASE OB_1NP_KPRAVA_02:
				{
				CALL 'SEQ_KAM_PRAVA_2'
				}
			CASE OB_1NP_KPRAVA_03:
				{
				CALL 'SEQ_KAM_PRAVA_3'
				}
			CASE OB_1NP_KPRAVA_04:
				{
				CALL 'SEQ_KAM_PRAVA_4'
				}
			}
		}
}
DEFINE_CALL 'SEQ_SRDCE_CHOD_VRETENO'
{
	IF (SQ_CHOD_VRETENO >0)		////// CHODBA VRETENO		
		  {
		  SEND_COMMAND dvMyTP_01,"'^TXT-155,0,MOD: SRDCE PULS'"

				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_W05, RELAX_0NP_OBRAZ_WHITE_5A, 50)
				WAIT 5
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_C05, RELAX_0NP_OBRAZ_COLD_5A, 45)
				WAIT 10
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_R05, RELAX_0NP_OBRAZ_RED_5A, 40)
				WAIT 15
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_G05, RELAX_0NP_OBRAZ_GREEN_5A, 35)
				WAIT 20
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_B05, RELAX_0NP_OBRAZ_BLUE_5A, 30)									///	Studena
				}
			CASE 2:
				{
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_W05, RELAX_0NP_OBRAZ_WHITE_5B, 50)
				WAIT 5
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_C05, RELAX_0NP_OBRAZ_COLD_5B, 45)
				WAIT 10
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_R05, RELAX_0NP_OBRAZ_RED_5B, 40)
				WAIT 15
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_G05, RELAX_0NP_OBRAZ_GREEN_5B, 35)
				WAIT 20
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_B05, RELAX_0NP_OBRAZ_BLUE_5B, 30)	
				}
			}
		    }
		ELSE	/// CIKLICKY VYPINA DOKUD BEZI TIMER - TOHLE MUZE DELAT PROBLEM U SCEN KDE BY MELI JET RGB V NEJAKEM ZVLASTNIM REZIMU
		    {
		    IF ((RELAX_1PP_RGB_05A_ACTIVE=FALSE) && (RELAX_1PP_RGB_05B_ACTIVE=FALSE))
			    {
			    CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_R05,0,2)								/// Cervena
			    CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_G05,0,2)								///	Zelena 
			    CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_B05,0,2)								///	Modra 
			    CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_C05,0,2)								///	 
			    CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_W05,0,2)								///	 
			    SEND_COMMAND dvMyTP_01,"'^TXT-641,0,RGB OFF'"
			    }
			}
}

DEFINE_CALL 'SEKVENCE_RELAX_1PP_RGB_5B'						
{
  IF (RELAX_1PP_RGB_05B_ACTIVE = TRUE) 
		{
		IF (RELAX_1PP_RGB_KROK > 2) // Pro RGB pres sceny pouze dva kroky
			{
			RELAX_1PP_RGB_KROK = 1
			}
		CALL 'REQUEST_CHANNELS_1PP_RELAX_RGB5'
		SWITCH (RELAX_1PP_RGB_KROK)
			{
			CASE 1:
				{
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_W05, RELAX_0NP_OBRAZ_WHITE_5A, 50)
				WAIT 5
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_C05, RELAX_0NP_OBRAZ_COLD_5A, 45)
				WAIT 10
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_R05, RELAX_0NP_OBRAZ_RED_5A, 40)
				WAIT 15
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_G05, RELAX_0NP_OBRAZ_GREEN_5A, 35)
				WAIT 20
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_B05, RELAX_0NP_OBRAZ_BLUE_5A, 30)									///	Studena
				}
			CASE 2:
				{
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_W05, RELAX_0NP_OBRAZ_WHITE_5B, 50)
				WAIT 5
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_C05, RELAX_0NP_OBRAZ_COLD_5B, 45)
				WAIT 10
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_R05, RELAX_0NP_OBRAZ_RED_5B, 40)
				WAIT 15
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_G05, RELAX_0NP_OBRAZ_GREEN_5B, 35)
				WAIT 20
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_B05, RELAX_0NP_OBRAZ_BLUE_5B, 30)	
				}
			SEND_COMMAND dvMyTP_01,"'^TXT-641,0,','E2 ',ITOA(RELAX_1PP_RGB_KROK)"
			}
		    }
		ELSE	/// CIKLICKY VYPINA DOKUD BEZI TIMER - TOHLE MUZE DELAT PROBLEM U SCEN KDE BY MELI JET RGB V NEJAKEM ZVLASTNIM REZIMU
		    {
		    IF ((RELAX_1PP_RGB_05A_ACTIVE=FALSE) && (RELAX_1PP_RGB_05B_ACTIVE=FALSE))
			    {
			    CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_R05,0,2)								/// Cervena
			    CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_G05,0,2)								///	Zelena 
			    CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_B05,0,2)								///	Modra 
			    CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_C05,0,2)								///	 
			    CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_W05,0,2)								///	 
			    SEND_COMMAND dvMyTP_01,"'^TXT-641,0,RGB OFF'"
			    }
			}
}

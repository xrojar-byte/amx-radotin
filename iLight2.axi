DEFINE_CALL 'SEQ_SRDCE_LOZNICE_ANGEL'
{
	IF (SQ_LOZ_SRDCE >0)		////// LOZNICE ANGEL SRDCE	
		  {
		  SWITCH (SQ_LOZ_SRDCE)
			{
			CASE LOZ_2NP_SRDCE_01:
				{
				CALL 'SEQ_LOZ_SRDCE_1'
				}
			CASE LOZ_2NP_SRDCE_02:
				{
				CALL 'SEQ_LOZ_SRDCE_2'
				}
			CASE LOZ_2NP_SRDCE_03:
				{
				CALL 'SEQ_LOZ_SRDCE_3'
				}
			CASE LOZ_2NP_SRDCE_04:
				{
				CALL 'SEQ_LOZ_SRDCE_4'
				}
			}
		}
	ELSE
		{
		CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_22,00,0)	// RED
		CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_23,00,0)	// GREEN
		CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_24,00,0)	// BLUE
		CALL 'ILIGHT_CHANNEL_VALUE' (SV_2NP_LOZNICE_25,00,0)	// WHITE	
		}
}

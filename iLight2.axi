/////////////////// RELAX OBRAZY PRES PERZIST SCENY //////////////	

DEFINE_CALL 'SEKVENCE_RELAX_1PP_RGB_START' //PRO OBRAZY RELAX
{	
		CALL 'SEKVENCE_RELAX_1PP_RGB_1A'
		CALL 'SEKVENCE_RELAX_1PP_RGB_1B'
		CALL 'SEKVENCE_RELAX_1PP_RGB_2A'
		CALL 'SEKVENCE_RELAX_1PP_RGB_2B'
		CALL 'SEKVENCE_RELAX_1PP_RGB_3A'
		CALL 'SEKVENCE_RELAX_1PP_RGB_3B'
		CALL 'SEKVENCE_RELAX_1PP_RGB_4A'
		CALL 'SEKVENCE_RELAX_1PP_RGB_4B'
		CALL 'SEKVENCE_RELAX_1PP_RGB_5A'
		CALL 'SEKVENCE_RELAX_1PP_RGB_5B'
}

	
DEFINE_CALL 'RELAX_1PP_RGB_TIMER' (CHAR CAS)	// ZAKLADNI CASOVAC PRO 1PP RELAX - SEKVENCE PRO OBRAZY
{
	RELAX_1PP_RGB_WAIT_TIME = CAS
	IF (RELAX_1PP_RGB_KROK > 2) // Pro RGB pres sceny pouze dva kroky
		RELAX_1PP_RGB_KROK = 1
	IF (RELAX_1PP_RGB_TIMER_ACTIVE=TRUE)
		{
			SEND_STRING 0,'TIMER RELAX START'
			CALL 'SEKVENCE_RELAX_1PP_RGB_START'
			WAIT RELAX_1PP_RGB_WAIT_TIME 'SEKVENCE_RELAX_1PP_RGB_WAIT'
				{
				RELAX_1PP_RGB_KROK++
				CALL 'RELAX_1PP_RGB_TIMER' (CAS)
				}
		}
}	

DEFINE_CALL 'RELAX_1PP_RGB_TIMER_DOUBLE' // CASOVAC 2NP RELAX zdvojeny natvrdo 500 - CHAR nebere vice nez 255
{
	IF (RELAX_1PP_RGB_KROK > 2) 
		RELAX_1PP_RGB_KROK = 1
	IF (RELAX_1PP_RGB_TIMER_ACTIVE=TRUE)
		{
			SEND_STRING 0,'TIMER RELAX START'
			CALL 'SEKVENCE_RELAX_1PP_RGB_START'
			SEND_COMMAND dvMyTP_01,"'^TXT-51,0,','RGB CASE ',ITOA(RELAX_1PP_RGB_KROK)"
			SEND_LEVEL dvMyTP_01,153,RELAX_1PP_RGB_KROK*0.5 // ASI BYCH ODSTRANIL, TEXT DLE MNE UPLNE STACI
			WAIT 400 'SEKVENCE_RELAX_1PP_RGB_WAIT'
				{
				RELAX_1PP_RGB_KROK++
				CALL 'RELAX_1PP_RGB_TIMER_DOUBLE'
				}
		}
	 
}	


DEFINE_CALL 'RELAX_1PP_RGB_TIMER_STOP'
{
	IF ((RELAX_1PP_RGB_01A_ACTIVE=FALSE) && (RELAX_1PP_RGB_02A_ACTIVE=FALSE) && (RELAX_1PP_RGB_03A_ACTIVE=FALSE) && (RELAX_1PP_RGB_04A_ACTIVE=FALSE) && (RELAX_1PP_RGB_05A_ACTIVE=FALSE))
		{
		CALL 'SEKVENCE_RELAX_1PP_RGB_SVETLA_ZHASNOUT'
		RELAX_1PP_RGB_SEKVENCE = RGB_0RELAX_K_00 ////BYLO TAM RGB_1PP_RELAXR_00 - NEVIM ZDA TAM MA BYT TATO KONSTANTA 
		RELAX_1PP_RGB_TIMER_ACTIVE=FALSE
		CANCEL_WAIT 'SEKVENCE_RELAX_1PP_RGB_WAIT'
		SEND_COMMAND dvMyTP_01,"'^TXT-51,0,','RGB OFF'"
		//SEND_STRING 0,'TIMER RELAX STOP'
		//SEND_LEVEL dvMyTP_01,153,0 // ASI BYCH ODSTRANIL, TEXT DLE MNE UPLNE STACI
		}
}
DEFINE_CALL 'SEKVENCE_RELAX_1PP_RGB_STOP'
{
	RELAX_1PP_RGB_01A_ACTIVE = FALSE
	RELAX_1PP_RGB_02A_ACTIVE = FALSE
	RELAX_1PP_RGB_03A_ACTIVE = FALSE
	RELAX_1PP_RGB_04A_ACTIVE = FALSE
	RELAX_1PP_RGB_05A_ACTIVE = FALSE
	RELAX_1PP_RGB_01B_ACTIVE = FALSE
	RELAX_1PP_RGB_02B_ACTIVE = FALSE
	RELAX_1PP_RGB_03B_ACTIVE = FALSE
	RELAX_1PP_RGB_04B_ACTIVE = FALSE
	RELAX_1PP_RGB_05B_ACTIVE = FALSE
	RELAX_1PP_RGB_SEKVENCE = RGB_0RELAX_K_00 ////BYLO TAM RGB_1PP_RELAXR_00 - NEVIM ZDA TAM MA BYT TATO KONSTANTA
	RELAX_1PP_RGB_TIMER_ACTIVE=FALSE
	CALL 'RELAX_1PP_RGB_TIMER_STOP'  /// TADY BUDE MOZNA PROBLEM - ZHASNU SVETLA, ALE TY MOUHOU BYT JIZ NASTAVENA NEJAKOU SCENOU. BUD PONECHAM,NEBO PRIDAM VLASTNI STOP
}

DEFINE_CALL 'SEKVENCE_RELAX_1PP_RGB_SVETLA_ZHASNOUT'
{
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_R01,00,0)							///    	CERVENA	
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_R02,00,0)							///		CERVENA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_R03,00,0)							///		CERVENA 	
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_R04,00,0)							///		CERVENA 
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_R05,00,0)							///		CERVENA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_B01,00,0)							///		MODRA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_B02,00,0)							///		MODRA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_B03,00,0)							///		MODRA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_B04,00,0)							///		MODRA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_B05,00,0)							///		MODRA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_G01,00,0)							///		ZELENA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_G02,00,0)							///		ZELENA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_G03,00,0)							///		ZELENA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_G04,00,0)							///		ZELENA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_G05,00,0)							///		ZELENA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_C01,00,0)							///		STUDENA BILA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_C02,00,0)							///		STUDENA BILA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_C03,00,0)							///		STUDENA BILA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_C04,00,0)							///		STUDENA BILA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_C05,00,0)							///		STUDENA BILA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_W01,00,0)							///		TEPLA BILA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_W02,00,0)							///		TEPLA BILA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_W03,00,0)							///		TEPLA BILA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_W04,00,0)							///		TEPLA BILA
	CALL 'ILIGHT_CHANNEL_VALUE' (SV_RELAX_1PP_RGB_W05,00,0)							///		TEPLA BILA
}

DEFINE_CALL 'SEKVENCE_RELAX_1PP_RGB_1A'						/// RGB SVETLO 1	
{
	IF (RELAX_1PP_RGB_01A_ACTIVE = TRUE) 
		{
		SEND_STRING 0,'RGB 1A ON'
		IF (RELAX_1PP_RGB_KROK > 2) // Pro RGB pres sceny pouze dva kroky
			{
			RELAX_1PP_RGB_KROK = 1
			}
		SEND_COMMAND dvMyTP_01,"'^TXT-637,0,','A1 - ',ITOA(RELAX_1PP_RGB_KROK)"
		CALL 'REQUEST_CHANNELS_1PP_RELAX_RGB1'
		SWITCH (RELAX_1PP_RGB_KROK)
			{
			CASE 1:
				{
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_W01, RELAX_0NP_OBRAZ_WHITE_1A, 50)
				WAIT 5
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_C01, RELAX_0NP_OBRAZ_COLD_1A, 45)
				WAIT 10
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_R01, RELAX_0NP_OBRAZ_RED_1A, 40)
				WAIT 15
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_G01, RELAX_0NP_OBRAZ_GREEN_1A, 35)
				WAIT 20
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_B01, RELAX_0NP_OBRAZ_BLUE_1A, 30)									///	Studena
				}
			CASE 2:
				{
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_W01, RELAX_0NP_OBRAZ_WHITE_1B, 50)
				WAIT 5
				CALL 'VYVOLEJ_PERSIST_LEVEL_2' (SV_RELAX_1PP_RGB_C01, RELAX_0NP_OBRAZ_COLD_1B, 45)
				WAIT 10

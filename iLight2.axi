DEFINE_CALL 'ULOZ LEVEL' (CHAR ILT_MAM[])							// ULOZENI UROVNE
{		
	LOCAL_VAR CHAR kLEVEL[3]
	LOCAL_VAR CHAR kCHANNEL_AREA[10]
	LOCAL_VAR CHAR sLEVEL
	kLEVEL = "ILT_MAM[11],ILT_MAM[12],ILT_MAM[13]"
	kCHANNEL_AREA = "'CH',ILT_MAM[1],ILT_MAM[2],ILT_MAM[3],':A',ILT_MAM[6],ILT_MAM[7],ILT_MAM[8]"
	sLEVEL = ATOI(kLEVEL)  //ATOI converts a character representation of a number to a signed 32-bit integer.
	IF (UKLADANI_ACTIVE=TRUE)
		{
		SEND_STRING 0,"'SAVE LEVEL FOR CHANNEL:AREA = <',kCHANNEL_AREA,'><',kLEVEL,'>'" 
		IF ((kCHANNEL_AREA = 'CH002:A017'))		////// OBYVAK KRB STRED TEPLA LED		
			  {
			  SWITCH (nVSTUP)
				{
				CASE SCENA_OB_1A:
					{
					  SEND_STRING 0,"'kLEVEL=: <',kLEVEL,'>'" 
					  SEND_STRING 0,"'FORMAT LEVEL=: <',sLEVEL,'>'" 
					  OB_KAMEN_STRED_1A = sLEVEL
					  UKLADANI_ACTIVE=FALSE
					  SEND_STRING 0,'CHANNEL OBYVAK 1A ULOZEN'
					}
				CASE SCENA_OB_1B:
					{
					  SEND_STRING 0,"'kLEVEL=: <',kLEVEL,'>'"
					  SEND_STRING 0,"'FORMAT LEVEL=: <',sLEVEL,'>'"
					  OB_KAMEN_STRED_1B  = sLEVEL
					  UKLADANI_ACTIVE=FALSE
					  SEND_STRING 0,'CHANNEL OBYVAK 1B ULOZEN'
					}	
				CASE SCENA_OB_1C:
					{
					  SEND_STRING 0,"'kLEVEL=: <',kLEVEL,'>'" 
					  SEND_STRING 0,"'FORMAT LEVEL=: <',sLEVEL,'>'"
					  OB_KAMEN_STRED_1C  = sLEVEL
					  UKLADANI_ACTIVE=FALSE
					  SEND_STRING 0,'CHANNEL OBYVAK 1C ULOZEN'
					}
				CASE SCENA_OB_1D:
					{
					  SEND_STRING 0,"'kLEVEL=: <',kLEVEL,'>'" 
					  SEND_STRING 0,"'FORMAT LEVEL=: <',sLEVEL,'>'" 
					  OB_KAMEN_STRED_1D = sLEVEL
					  UKLADANI_ACTIVE=FALSE
					  SEND_STRING 0,'CHANNEL OBYVAK 1D ULOZEN'
					}
				CASE SCENA_OB_1E:
					{
					  SEND_STRING 0,"'kLEVEL=: <',kLEVEL,'>'"
					  SEND_STRING 0,"'FORMAT LEVEL=: <',sLEVEL,'>'"
					  OB_KAMEN_STRED_1E  = sLEVEL
					  UKLADANI_ACTIVE=FALSE
					  SEND_STRING 0,'CHANNEL OBYVAK 1E ULOZEN'
					}
				CASE SCENA_OB_1F:
					{
					  SEND_STRING 0,"'kLEVEL=: <',kLEVEL,'>'" 
					  SEND_STRING 0,"'FORMAT LEVEL=: <',sLEVEL,'>'"
					  OB_KAMEN_STRED_1F  = sLEVEL
					  UKLADANI_ACTIVE=FALSE
					  SEND_STRING 0,'CHANNEL OBYVAK 1F ULOZEN'
					}
				CASE SCENA_OB_1G:
					{
					  SEND_STRING 0,"'kLEVEL=: <',kLEVEL,'>'" 
					  SEND_STRING 0,"'FORMAT LEVEL=: <',sLEVEL,'>'"
					  OB_KAMEN_STRED_1G  = sLEVEL
					  UKLADANI_ACTIVE=FALSE
					  SEND_STRING 0,'CHANNEL OBYVAK 1G ULOZEN'
					}
				
				}
			}
		ELSE IF ((kCHANNEL_AREA = 'CH001:A017'))		////// OBYVAK KRB STRED STUDENA LED	
			  {
			  SWITCH (nVSTUP)
				{
				CASE SCENA_OB_2A:
					{
					  OB_KAMEN_STRED_2A = sLEVEL
					  UKLADANI_ACTIVE=FALSE
					}
				CASE SCENA_OB_2B:
					{
					  OB_KAMEN_STRED_2B  = sLEVEL
					  UKLADANI_ACTIVE=FALSE
					}	
				CASE SCENA_OB_2C:
					{
					  OB_KAMEN_STRED_2C  = sLEVEL
					  UKLADANI_ACTIVE=FALSE
					}
				CASE SCENA_OB_2D:
					{
					  OB_KAMEN_STRED_2D = sLEVEL
					  UKLADANI_ACTIVE=FALSE
					}
				CASE SCENA_OB_2E:
					{
					  OB_KAMEN_STRED_2E  = sLEVEL
					  UKLADANI_ACTIVE=FALSE
					}
				CASE SCENA_OB_2F:
					{
					  OB_KAMEN_STRED_2F  = sLEVEL
					  UKLADANI_ACTIVE=FALSE
					}
				CASE SCENA_OB_2G:
					{
					  OB_KAMEN_STRED_2G  = sLEVEL
					  UKLADANI_ACTIVE=FALSE
					}
				CASE SCENA_OB_2H:
					{
					  OB_KAMEN_STRED_2H  = sLEVEL
					  UKLADANI_ACTIVE=FALSE
					}
				CASE SCENA_OB_2I:

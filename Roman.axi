DEFINE_DEVICE

// dvTopeni			 		= 5001:2:1
// Micropel MPC405, prevodnik CA3 pro RS232 AMX, p.Gossel ma jeste CA4 - pro komunikaci se systemem zvenku po ethernetu

// dvETM			 		= 5001:3:1

vdvVIRTUAL_TOPENI    	 = 35001:1:0 // PRO KOMUNIKACI S MODULEM TOPENI
vdvVIRTUAL_MICROPEL	 = 36001:1:0 // PRO KOMUNIKACI MODULU TOPENI S MODULEM MICROPEL
vdvETM_VIRTUAL		 = 36002:1:1
vdvVIRTUAL_TC		 = 36003:1:1 // PRO KOMUNIKACI MODULU TOPENI S MODBUS MODULEM TEPELNEHO CERPADLA

DEFINE_CONSTANT

DEFINE_VARIABLE

PERSISTENT INTEGER nTUV_LETO
PERSISTENT INTEGER nTUV_PRECHOD
PERSISTENT INTEGER nTUV_ZIMA
PERSISTENT INTEGER nTUV_UTLUM // PRI CENTRALNIM UTLUMU DOMU BEZ OHLEDU NA OBDOBI

DEFINE_START

DEFINE_MODULE 'ModBus_IP_MOD' TEPCER_MODULE (vdvVIRTUAL_TC, dvTepCerpadlo)
//DEFINE_MODULE 'TOPENI_MOD' TOPENI_MODULE(vdvVIRTUAL_TOPENI,vdvVIRTUAL_MICROPEL,dvTopeni,dvMyTP_01,dvTeplomer)
DEFINE_MODULE 'TOPENI_MOD' TOPENI_MODULE(vdvVIRTUAL_TOPENI,vdvVIRTUAL_MICROPEL,dvTopeni,dvMyTP_01,
  vdvVIRTUAL_TC,nTUV_LETO,nTUV_PRECHOD,nTUV_ZIMA,nTUV_UTLUM)
DEFINE_MODULE 'XELEKTROMER_ACEAN_MOD' ETM_MODULE(vdvETM_VIRTUAL,dvElektroHome,dvMyTP_01)


	CASE  68: { // NOVE 3/167
		ON [dvMyTP_03,167]
		OFF [dvMyTP_03,166]
		CALL 'ILIGHT_CHANNEL_OFF' (VYP_NECO4_1NP)
		}
    }
  }
}

DEFINE_CALL 'VYPINACE_RESTART'
{
   IF (SW_SU_OBYVAK = TRUE)	/// 
    {
    CALL 'ILIGHT_CHANNEL_OFF' (VYP_SU_OBYVAK)
    WAIT 25
    CALL 'ILIGHT_CHANNEL_ON' (VYP_SU_OBYVAK)
    }   
  wait 3
  IF (SW_SUPLIK_OHRV = TRUE)	/// 
    {
    CALL 'ILIGHT_CHANNEL_OFF' (VYP_SUPLIK_OHRV)
    WAIT 25
    CALL 'ILIGHT_CHANNEL_ON' (VYP_SUPLIK_OHRV)
    }
 wait 6 
 IF (SW_TV_OBYVAK = TRUE)	/// 
    {
    CALL 'ILIGHT_CHANNEL_OFF' (VYP_TV_OBYVAK)
    WAIT 25
    CALL 'ILIGHT_CHANNEL_ON' (VYP_TV_OBYVAK)
		
    }
  wait 9
  IF (SW_ZASUVKY_LINKA = TRUE)	/// 
    {
    CALL 'ILIGHT_CHANNEL_OFF' (VYP_ZASUVKY_LINKA)
    WAIT 25
    CALL 'ILIGHT_CHANNEL_ON' (VYP_ZASUVKY_LINKA)	
    }
  wait 12  
 IF (SW_KONVICE_KUCH = TRUE)	/// 
    {
    CALL 'ILIGHT_CHANNEL_OFF' (VYP_KONVICE_KUCH)
    WAIT 25
    CALL 'ILIGHT_CHANNEL_ON' (VYP_KONVICE_KUCH)	
    }
 wait 15
 IF (SW_TV_ZIM_ZAHR = TRUE)	/// 
    {
    CALL 'ILIGHT_CHANNEL_OFF' (VYP_TV_ZIM_ZAHR)
    WAIT 25
    CALL 'ILIGHT_CHANNEL_ON' (VYP_TV_ZIM_ZAHR)
    } 
  wait 18  
  IF (SW_ZESILOVAC = TRUE)	/// 
    {
    CALL 'ILIGHT_CHANNEL_OFF' (VYP_ZESILOVAC)
    WAIT 25
    CALL 'ILIGHT_CHANNEL_ON' (VYP_ZESILOVAC)
    }  
}

DEFINE_LATCHING

DEFINE_MUTUALLY_EXCLUSIVE

	
DEFINE_START

DEFINE_EVENT 


BUTTON_EVENT[dvMyTP_03,nBTN_VypElektrina]
{
  PUSH:
  {
    STACK_VAR INTEGER nBtnIdx
    nBtnIdx = GET_LAST(nBTN_VypElektrina)
    SWITCH(nBtnIdx)
    {
      CASE   1: {
		CALL 'ILIGHT_CHANNEL_OFF' (VYP_PRACKA)
		WAIT 50

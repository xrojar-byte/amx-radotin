DEFINE_DEVICE

////////////////////	KONTAKTY	//////////////////////




DEFINE_CONSTANT

TL_SOLAX = 23 // SETS AN ID FOR THE TIMELINE
//FALSE=0
//TRUE=1

DEFINE_TYPE

DEFINE_VARIABLE
LONG SOLAX_CAS[] = {26002,2000}
//VOLATILE INTEGER NAPAJENI_VYPADEK=0		//
VOLATILE INTEGER TLAC_01=0
VOLATILE INTEGER TLAC_02=0
VOLATILE INTEGER TLAC_03=0
VOLATILE INTEGER TLAC_04=0
VOLATILE INTEGER TLAC_05=0
VOLATILE INTEGER TLAC_06=0

///////////////////////////////// 


DEFINE_LATCHING

DEFINE_MUTUALLY_EXCLUSIVE
DEFINE_CALL 'VYPADEK_ELEKTRINY'
{
				SEND_STRING 0,"'ZPRACOVAVAM NAPAJENI'"   /// JENOM PRO TESTY
				IF (NAPAJENI_VYPADEK=1)
					{
					SEND_STRING 0,"'CEKAM NA OBNOVU'"   /// JENOM PRO TESTY
					CANCEL_WAIT 'CEKACKA2'
					ON [dvMyTP_03,76]
					ON [dvMyTP_03,77]
					OFF [dvMyTP_03,78]
					WAIT 20 'CEKACKA1'
						{
						SEND_STRING 0,"'OBNOVUJI NAPAJENI'"   /// JENOM PRO TESTY
						CALL 'ILIGHT_CHANNEL_OFF' (SP_HAVAR_VARNA_DESKA)
						WAIT 5
						CALL 'ILIGHT_CHANNEL_OFF' (SP_HAVAR_SAUNA_RELAX)
						WAIT 10 
						CALL 'ILIGHT_CHANNEL_OFF' (SP_HAVAR_VIRIVKA_RELAX)
						WAIT 15
						CALL 'ILIGHT_CHANNEL_OFF' (SP_HAVAR_TEPEL_CERPADLO)
						WAIT 20
						CALL 'ILIGHT_CHANNEL_OFF' (SP_HAVAR_TRAFA_SVETLA)
						WAIT 25
						CALL 'ILIGHT_CHANNEL_OFF' (SP_HAVAR_NABIJ_AUTO)
						}
					}
				ELSE IF	(NAPAJENI_VYPADEK=0)
					{
					SEND_STRING 0,"'CEKAM NA VYPNUTI'"   /// JENOM PRO TESTY
					CANCEL_WAIT 'CEKACKA1'
					OFF [dvMyTP_03,76]
					OFF [dvMyTP_03,77]
					ON [dvMyTP_03,78]
					WAIT 20 'CEKACKA2'
						{
						SEND_STRING 0,"'VYPINAM NAPAJENI'"   /// JENOM PRO TESTY
						CALL 'ILIGHT_CHANNEL_ON' (SP_HAVAR_VARNA_DESKA)
						WAIT 5
						CALL 'ILIGHT_CHANNEL_ON' (SP_HAVAR_SAUNA_RELAX)
						WAIT 10
						CALL 'ILIGHT_CHANNEL_ON' (SP_HAVAR_VIRIVKA_RELAX)
						WAIT 15
						CALL 'ILIGHT_CHANNEL_ON' (SP_HAVAR_TEPEL_CERPADLO)
						WAIT 20
						CALL 'ILIGHT_CHANNEL_ON' (SP_HAVAR_TRAFA_SVETLA)
						WAIT 25
						CALL 'ILIGHT_CHANNEL_ON' (SP_HAVAR_NABIJ_AUTO)
						}
					}
}

DEFINE_CALL 'REQUEST_CHANNEL_VYPADEK'
	{
	CALL 'ILIGHT_CHANNEL_REQUEST' (SP_HAVAR_VARNA_DESKA)
	WAIT 5
	CALL 'ILIGHT_CHANNEL_REQUEST' (SP_HAVAR_SAUNA_RELAX)
	WAIT 10
	CALL 'ILIGHT_CHANNEL_REQUEST' (SP_HAVAR_VIRIVKA_RELAX)
	WAIT 15
	CALL 'ILIGHT_CHANNEL_REQUEST' (SP_HAVAR_TEPEL_CERPADLO)
	WAIT 20
	CALL 'ILIGHT_CHANNEL_REQUEST' (SP_HAVAR_TRAFA_SVETLA)
	WAIT 25
	CALL 'ILIGHT_CHANNEL_REQUEST' (SP_HAVAR_NABIJ_AUTO)
	}
	
DEFINE_CALL 'ZOBRAZ_TLACITKA_VYPADEK'
	{
	IF (TIMELINE_ACTIVE (TL_SOLAX))
		{
		//
		}
	ELSE
		{
		TIMELINE_CREATE(TL_SOLAX,SOLAX_CAS,2,TIMELINE_RELATIVE,TIMELINE_REPEAT)
		}
	IF (NAPAJENI_VYPADEK=0)		// NAPAJENI V PORADKU 
		{
		ON [dvMyTP_03,51]
		ON [dvMyTP_03,54]
		ON [dvMyTP_03,57]
		ON [dvMyTP_03,60]
		ON [dvMyTP_03,63]
		ON [dvMyTP_03,66]
		ON [dvMyTP_03,78]
		OFF [dvMyTP_03,75]
		(*
		OFF [dvMyTP_03,50]
		OFF [dvMyTP_03,52]
		OFF [dvMyTP_03,53]
		OFF [dvMyTP_03,55]
		OFF [dvMyTP_03,56]
		OFF [dvMyTP_03,58]
		OFF [dvMyTP_03,59]
		OFF [dvMyTP_03,61]
		OFF [dvMyTP_03,62]
		OFF [dvMyTP_03,64]
		OFF [dvMyTP_03,65]
		OFF [dvMyTP_03,67]
		*)
		}
	ELSE
		{
		ON [dvMyTP_03,75]
		CALL 'UKAZ_STAV_ELEKT'
		}
}
DEFINE_CALL 'UKAZ_STAV_ELEKT'
	{
	IF (TLAC_01=0)
		{
		//OFF	[dvMyTP_03,50]
		OFF	[dvMyTP_03,51]
		//ON	[dvMyTP_03,52]
		}
	ELSE
		{
		//ON	[dvMyTP_03,50]
		OFF	[dvMyTP_03,51]
		//OFF	[dvMyTP_03,52]
		}
	IF (TLAC_02=0)
		{
		//OFF	[dvMyTP_03,53]
		OFF	[dvMyTP_03,54]
		//ON	[dvMyTP_03,55]
		}
	ELSE
		{
		//ON	[dvMyTP_03,53]
		OFF	[dvMyTP_03,54]
		//OFF	[dvMyTP_03,55]
		}
	IF (TLAC_03=0)
		{
		//OFF	[dvMyTP_03,56]
		OFF	[dvMyTP_03,57]
		//ON	[dvMyTP_03,58]
		}
	ELSE
		{
		//ON	[dvMyTP_03,56]
		OFF	[dvMyTP_03,57]
		//OFF	[dvMyTP_03,58]
		}
	IF (TLAC_04=0)
		{
		//OFF	[dvMyTP_03,59]
		OFF	[dvMyTP_03,60]
		//ON	[dvMyTP_03,61]
		}
	ELSE
		{
		//ON	[dvMyTP_03,59]
		OFF	[dvMyTP_03,60]
		//OFF	[dvMyTP_03,61]
		}
	IF (TLAC_05=0)
		{
		//OFF	[dvMyTP_03,62]
		OFF	[dvMyTP_03,63]
		//ON	[dvMyTP_03,64]
		}
	ELSE
		{
		//ON	[dvMyTP_03,62]
		OFF	[dvMyTP_03,63]
		//OFF	[dvMyTP_03,64]
		}
	IF (TLAC_06=0)
		{
		//OFF	[dvMyTP_03,65]
		OFF	[dvMyTP_03,66]
		//ON	[dvMyTP_03,67]
		}
	ELSE
		{
		//ON	[dvMyTP_03,65]
		OFF	[dvMyTP_03,66]
		//OFF	[dvMyTP_03,67]
		}
}
	
DEFINE_START

DEFINE_EVENT 

BUTTON_EVENT[dvMyTP_03,50]	/// VYPADEK NAPAJENI Varna deska
BUTTON_EVENT[dvMyTP_03,51]
BUTTON_EVENT[dvMyTP_03,52]									
{
	 PUSH:
		{
		SWITCH(BUTTON.INPUT.CHANNEL)
		  {
			CASE 50:{
						CALL 'ILIGHT_CHANNEL_OFF' (SP_HAVAR_VARNA_DESKA)
						ON [dvMyTP_03,50]
						//OFF [dvMyTP_03,52]
						TLAC_01=1
						WAIT 10
						CALL 'ILIGHT_CHANNEL_REQUEST' (SP_HAVAR_VARNA_DESKA)
						}
			CASE 51:{
						CALL 'ILIGHT_CHANNEL_OFF' (SP_HAVAR_VARNA_DESKA)
						//OFF [dvMyTP_03,50]
						//OFF [dvMyTP_03,52]
						WAIT 10
						CALL 'ILIGHT_CHANNEL_REQUEST' (SP_HAVAR_VARNA_DESKA)
						}
			CASE 52:{
						CALL 'ILIGHT_CHANNEL_ON' (SP_HAVAR_VARNA_DESKA)
						OFF [dvMyTP_03,50]
						//ON [dvMyTP_03,52]
						TLAC_01=0
						WAIT 10
						CALL 'ILIGHT_CHANNEL_REQUEST' (SP_HAVAR_VARNA_DESKA)
						}
			}
		}
}

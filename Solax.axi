BUTTON_EVENT[dvMyTP_03,77]	// SIMULACE TEST
BUTTON_EVENT[dvMyTP_03,78]									
{
	 PUSH:
		{
		SWITCH(BUTTON.INPUT.CHANNEL)
		  {
			CASE 77:{
					NAPAJENI_VYPADEK=1
					ON [dvMyTP_03,76]
					ON [dvMyTP_03,77]
					OFF [dvMyTP_03,78]
					CALL 'ILIGHT_CHANNEL_ON' (SP_HAVAR_VARNA_DESKA)
					CALL 'ILIGHT_CHANNEL_ON' (SP_HAVAR_SAUNA_RELAX)
					CALL 'ILIGHT_CHANNEL_ON' (SP_HAVAR_VIRIVKA_RELAX)
					CALL 'ILIGHT_CHANNEL_ON' (SP_HAVAR_TEPEL_CERPADLO)
					CALL 'ILIGHT_CHANNEL_ON' (SP_HAVAR_TRAFA_SVETLA)
					CALL 'ILIGHT_CHANNEL_ON' (SP_HAVAR_NABIJ_AUTO)
					}
			CASE 78:{
					NAPAJENI_VYPADEK=0
					OFF [dvMyTP_03,76]
					OFF [dvMyTP_03,77]
					ON [dvMyTP_03,78]
					CALL 'ILIGHT_CHANNEL_OFF' (SP_HAVAR_VARNA_DESKA)
					CALL 'ILIGHT_CHANNEL_OFF' (SP_HAVAR_SAUNA_RELAX)
					CALL 'ILIGHT_CHANNEL_OFF' (SP_HAVAR_VIRIVKA_RELAX)
					CALL 'ILIGHT_CHANNEL_OFF' (SP_HAVAR_TEPEL_CERPADLO)
					CALL 'ILIGHT_CHANNEL_OFF' (SP_HAVAR_TRAFA_SVETLA)
					CALL 'ILIGHT_CHANNEL_OFF' (SP_HAVAR_NABIJ_AUTO)
					}
			}
		}
}	
TIMELINE_EVENT[TL_SOLAX]    // EVENTS FOR TIMELINE
{
 SWITCH(Timeline.Sequence)
  {
    case 1:{          
			CALL 'REQUEST_CHANNEL_VYPADEK'
			}
    case 2:{     
			CALL 'ZOBRAZ_TLACITKA_VYPADEK'
           } 
	}
}	
				
DATA_EVENT[dvTP1]	//
{
  ONLINE: 
	{
	WAIT 10
	CALL 'ZOBRAZ_TLACITKA_VYPADEK'
	}
}  
DATA_EVENT[dvTP2]	//
{
  ONLINE: 
	{
	WAIT 10
	CALL 'ZOBRAZ_TLACITKA_VYPADEK'
	}
}  
DATA_EVENT[dvTP3]	//
{
  ONLINE: 
	{
	WAIT 10
	CALL 'ZOBRAZ_TLACITKA_VYPADEK'
	}
}  
DATA_EVENT[dvTP4]	//
{
  ONLINE: 
	{
	WAIT 10
	CALL 'ZOBRAZ_TLACITKA_VYPADEK'
	}
}  


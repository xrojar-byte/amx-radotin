BUTTON_EVENT[dvMyTP_03,65]	/// VYPADEK NAPAJENI Nabijecka auto
BUTTON_EVENT[dvMyTP_03,66]
BUTTON_EVENT[dvMyTP_03,67]									
{
	 PUSH:
		{
		SWITCH(BUTTON.INPUT.CHANNEL)
		  {
			CASE 65:{
						IF (NAPAJENI_VYPADEK=1)		// VYPADEK NAPAJENI 

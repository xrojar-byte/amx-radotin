DEFINE_DEVICE

////////////////////	KONTAKTY	//////////////////////
// dvKontaktA			= 32051:1:1		// Bouda - u lesa 1-4 / u pøístavku 5-8
// dvKontaktB			= 32052:1:1		// Dum sklep schody  1-3
// dvKontaktC			= 32053:1:1		// Sklep bazén u bazenu 1-3 / bazen 4-6 /// pri OK zapnuto vzdy 3 a 6



DEFINE_CONSTANT

TL_CERPADLA = 19 // SETS AN ID FOR THE TIMELINE
FALSE=0
TRUE=1

DEFINE_TYPE

DEFINE_VARIABLE
VOLATILE INTEGER PORUCHA_A1=0		// SCHODY DUM VSUDE  DEFAULT NASTAVENY OBRACENE HODNOTY
VOLATILE INTEGER PORUCHA_A2=0
VOLATILE INTEGER PORUCHA_A3=0
VOLATILE INTEGER NAPAJENI_A4=1		// ON=OK
VOLATILE INTEGER PORUCHA_A5=0		// 
VOLATILE INTEGER PORUCHA_A6=0		// 
VOLATILE INTEGER PORUCHA_A7=0		// 
VOLATILE INTEGER NAPAJENI_A8=1		// ON=OK
VOLATILE INTEGER PORUCHA_B1=0		// U LESA
VOLATILE INTEGER PORUCHA_B2=0		//
VOLATILE INTEGER NAPAJENI_B3=1		// ON=OK
VOLATILE INTEGER PORUCHA_C1=0		// U PRISTAVKU
VOLATILE INTEGER PORUCHA_C2=0		//
VOLATILE INTEGER NAPAJENI_C3=1		// ON=OK
VOLATILE INTEGER PORUCHA_C4=0		// 
VOLATILE INTEGER PORUCHA_C5=0		// 
VOLATILE INTEGER NAPAJENI_C6=1		// ON=OK



VOLATILE CHAR POPUP_ON=FALSE
VOLATILE CHAR STAV_CERPADEL[26] // = A000B00000000C0000D000E000
VOLATILE CHAR CERADLA_ZPRAVA
PERSISTENT CHAR PORUCHA_CERP1	// BEZI
PERSISTENT CHAR PORUCHA_CERP2	// VETSI ZAVADA
PERSISTENT CHAR PORUCHA_CERP3   // HAVARIE
PERSISTENT CHAR ZOBRAZENO_TP
LONG CERPADLA_CAS[] = {59000,59000,30000} //Cas pro krok je 59s
///////////////////////////////// 


DEFINE_LATCHING

DEFINE_MUTUALLY_EXCLUSIVE

DEFINE_CALL 'TIMELINE CERPADLO START'
	{
	IF (TIMELINE_ACTIVE (TL_CERPADLA))
		{
		SEND_STRING 0,"'TIMELINE CERPADLO BEZI'"
		}
	ELSE
		{
		TIMELINE_CREATE(TL_CERPADLA,CERPADLA_CAS,2,TIMELINE_RELATIVE,TIMELINE_REPEAT) 
		}
	}
	
DEFINE_CALL 'URCI_STAV_CERPADEL2'
	{
	LOCAL_VAR INTEGER iCERP1
	LOCAL_VAR INTEGER iCERP2
	LOCAL_VAR INTEGER iCERP3
	LOCAL_VAR INTEGER iCERP4
	LOCAL_VAR INTEGER iCERP5
	iCERP1= ((PORUCHA_A1)+(PORUCHA_A2)+(PORUCHA_A3)+(NAPAJENI_A4))
	iCERP2= ((PORUCHA_A5)+(PORUCHA_A6)+(PORUCHA_A7)+(NAPAJENI_A8))
	iCERP3= ((PORUCHA_B1)+(PORUCHA_B2)+(NAPAJENI_B3))
	iCERP4= ((PORUCHA_C1)+(PORUCHA_C2)+(NAPAJENI_C3))
	iCERP5= ((PORUCHA_C4)+(PORUCHA_C5)+(NAPAJENI_C6))
	IF (iCERP1<1)
		{
		SEND_STRING 0,"'PORUCHA NAPAJENI U LESA'"
		PORUCHA_CERP3=TRUE
		ON [dvMyTP_03,41]
		}
	ELSE IF (iCERP1=1)
		{
		OFF [dvMyTP_03,41]
		PORUCHA_CERP3=FALSE
		}
	ELSE IF (iCERP1>1)
		{
		OFF [dvMyTP_03,41]
		CALL 'DEKODUJ CERPADLA1'
		}
	IF (iCERP2<1)
		{
		SEND_STRING 0,"'PORUCHA NAPAJENI U PRISTAVKU'"
		PORUCHA_CERP3=TRUE
		ON [dvMyTP_03,42]
		}
	ELSE IF (iCERP2=1)
		{
		OFF [dvMyTP_03,42]
		PORUCHA_CERP3=FALSE
		}
	ELSE IF (iCERP2>1)
		{
		OFF [dvMyTP_03,42]
		CALL 'DEKODUJ CERPADLA2'
		}
	IF (iCERP3<1)
		{
		SEND_STRING 0,"'PORUCHA NAPAJENI SCHODY'"
		PORUCHA_CERP3=TRUE
		ON [dvMyTP_03,40]
		}
	ELSE IF (iCERP3=1)
		{
		OFF [dvMyTP_03,40]
		PORUCHA_CERP3=FALSE
		}
	ELSE IF (iCERP3>1)
		{
		OFF [dvMyTP_03,40]
		CALL 'DEKODUJ CERPADLA3'
		}
	IF (iCERP4<1)
		{
		SEND_STRING 0,"'PORUCHA NAPAJENI BAZEN'"
		PORUCHA_CERP3=TRUE
		ON [dvMyTP_03,43]
		}
	ELSE IF (iCERP4=1)
		{
		OFF [dvMyTP_03,43]
		PORUCHA_CERP3=FALSE
		}
	ELSE IF (iCERP4>1)
		{
		OFF [dvMyTP_03,43]
		CALL 'DEKODUJ CERPADLA4'
		}
	IF (iCERP5<1)
		{
		SEND_STRING 0,"'PORUCHA NAPAJENI BAZEN PØEPAD'"
		PORUCHA_CERP3=TRUE
		ON [dvMyTP_03,44]
		}
	ELSE IF (iCERP5=1)
		{
		OFF [dvMyTP_03,44]
		PORUCHA_CERP3=FALSE
		}
	ELSE IF (iCERP5>1)
		{
		OFF [dvMyTP_03,44]
		CALL 'DEKODUJ CERPADLA5'
		}
	WAIT 15
	CALL 'ZOBRAZ_TLACITKA_CERPADEL'
	}
	
DEFINE_CALL 'DEKODUJ CERPADLA1'
	{	
	IF (PORUCHA_A1=1)  // voda - cerpadlo bezi
		{
		SEND_COMMAND dvMyTP_03,"'^TXT-182,0,','PROVOZ'"
		SEND_COMMAND dvMyTP_01,"'^TXT-182,0,','PROVOZ'"
		IF (PORUCHA_A2=1)
			{
			SEND_STRING 0,"'PORUCHA CERPADLA 1'"
			ON [dvMyTP_03,10]
			// PORUCHA CERPADLA1
			IF (PORUCHA_A3=1)
				{
				SEND_STRING 0,"'ZAVAZNA PORUCHA CERPADEL'"
				// PORUCHA CERPADLA 1+2 VELKY POPLACH
				}
			}
		}	
	}
DEFINE_CALL 'DEKODUJ CERPADLA2'
	{	
	IF (PORUCHA_A5=1)  // voda - cerpadlo bezi
		{
		SEND_COMMAND dvMyTP_03,"'^TXT-183,0,','PROVOZ'"
		SEND_COMMAND dvMyTP_01,"'^TXT-183,0,','PROVOZ'"
		SEND_STRING 0,"'CERPADLO BEZI'"
		IF (PORUCHA_A6=1)
			{
			SEND_STRING 0,"'PORUCHA CERPADLA 1'"
			ON [dvMyTP_03,17]
			// PORUCHA CERPADLA1
			IF (PORUCHA_A7=1)
				{
				SEND_STRING 0,"'ZAVAZNA PORUCHA CERPADEL'"
				// PORUCHA CERPADLA 1+2 VELKY POPLACH
				}
			}	
		}
    }
DEFINE_CALL 'DEKODUJ CERPADLA3'
	{	
	IF (PORUCHA_B1=1)  // voda - cerpadlo bezi
		{
		SEND_COMMAND dvMyTP_03,"'^TXT-181,0,','PROVOZ'"
		SEND_COMMAND dvMyTP_01,"'^TXT-181,0,','PROVOZ'"
		IF (PORUCHA_B2=1)
			{
			SEND_STRING 0,"'PORUCHA CERPADLA 1'"
			ON [dvMyTP_03,10]
			// PORUCHA CERPADLA 1+2 VELKY POPLACH
			}
		}	
	}
DEFINE_CALL 'DEKODUJ CERPADLA4'
	{	
	IF (PORUCHA_C1=1)  // voda - cerpadlo bezi
		{
		SEND_COMMAND dvMyTP_03,"'^TXT-184,0,','PROVOZ'"
		SEND_COMMAND dvMyTP_01,"'^TXT-184,0,','PROVOZ'"
		IF (PORUCHA_C2=1)
			{
			SEND_STRING 0,"'PORUCHA CERPADLA 1'"
			ON [dvMyTP_03,21]
			// PORUCHA CERPADLA 1+2 VELKY POPLACH
			}
		}	
	}
DEFINE_CALL 'DEKODUJ CERPADLA5'
	{	
	IF (PORUCHA_C4=1)  // voda - cerpadlo bezi
		{
		SEND_COMMAND dvMyTP_03,"'^TXT-185,0,','PROVOZ'"			/// DOPUSTENI BAZEN
		SEND_COMMAND dvMyTP_01,"'^TXT-185,0,','PROVOZ'"
		}
	IF (PORUCHA_C5=1)
		{
		SEND_COMMAND dvMyTP_03,"'^TXT-186,0,','PROVOZ'"			/// VYPUSTENI BAZEN
		SEND_COMMAND dvMyTP_01,"'^TXT-186,0,','PROVOZ'"
		}
			
	}


DEFINE_CALL 'ZOBRAZ_TLACITKA_CERPADEL'
	{
	IF (PORUCHA_A1=TRUE)		// U LESA
		{
		SEND_COMMAND dvMyTP_01,"'^TXT-182,0,','PROVOZ'"
		}
	ELSE
		{
		SEND_COMMAND dvMyTP_01,"'^TXT-182,0,','OK'"
		OFF [dvMyTP_03,13]
		}
	IF (PORUCHA_A2=TRUE)
		{
		ON [dvMyTP_03,14]
		}
	ELSE
		{
		OFF [dvMyTP_03,14]
		}
	IF (PORUCHA_A3=TRUE)
		{
		ON [dvMyTP_03,15]
		}
	ELSE
		{
		OFF [dvMyTP_03,15]
		}
	IF (NAPAJENI_A4=TRUE)
		{
		OFF [dvMyTP_03,16]
		}
	ELSE
		{
		ON [dvMyTP_03,16]
		}
	IF (PORUCHA_A5=TRUE)		// U PRISTAVKU
		{
		SEND_COMMAND dvMyTP_01,"'^TXT-183,0,','PROVOZ'"
		}
	ELSE
		{
		SEND_COMMAND dvMyTP_01,"'^TXT-183,0,','OK'"
		OFF [dvMyTP_03,17]
		}
	IF (PORUCHA_A6=TRUE)
		{
		ON [dvMyTP_03,18]
		}
	ELSE
		{
		OFF [dvMyTP_03,18]
		}
	IF (PORUCHA_A7=TRUE)
		{
		ON [dvMyTP_03,19]
		}
	ELSE
		{
		OFF [dvMyTP_03,19]
		}
	IF (NAPAJENI_A8=TRUE)
		{
		OFF [dvMyTP_03,20]
		}
	ELSE
		{
		ON [dvMyTP_03,20]
		}
	IF (PORUCHA_B1=TRUE)		// SCHODY
		{
		SEND_COMMAND dvMyTP_01,"'^TXT-181,0,','PROVOZ'"
		//ON [dvMyTP_03,10]
		}
	ELSE
		{
		SEND_COMMAND dvMyTP_01,"'^TXT-181,0,','OK'"
		OFF [dvMyTP_03,10]
		}
	IF (PORUCHA_B2=TRUE)
		{
		ON [dvMyTP_03,11]
		}
	ELSE
		{
		OFF [dvMyTP_03,11]
		}
	IF (NAPAJENI_B3=TRUE)
		{
		OFF [dvMyTP_03,12]
		}
	ELSE
		{
		ON [dvMyTP_03,12]
		}
	IF (PORUCHA_C1=TRUE)		// U BAZENU
		{
		SEND_COMMAND dvMyTP_01,"'^TXT-184,0,','PROVOZ'"
		ON [dvMyTP_03,21]
		}
	ELSE
		{
		SEND_COMMAND dvMyTP_01,"'^TXT-184,0,','OK'"
		OFF [dvMyTP_03,21]
		}
	IF (PORUCHA_C2=TRUE)
		{
		ON [dvMyTP_03,22]
		}
	ELSE
		{
		OFF [dvMyTP_03,22]
		}
	IF (NAPAJENI_C3=TRUE)
		{
		OFF [dvMyTP_03,23]
		}
	ELSE
		{
		ON [dvMyTP_03,23]
		}
	IF (PORUCHA_C4=TRUE)		// BAZEN
		{
		SEND_COMMAND dvMyTP_01,"'^TXT-185,0,','PROVOZ'"
		OFF [dvMyTP_03,24]
		}
	ELSE
		{
		SEND_COMMAND dvMyTP_03,"'^TXT-185,0,','OK'"
		OFF [dvMyTP_03,24]
		}
	IF (PORUCHA_C5=TRUE)
		{
		SEND_COMMAND dvMyTP_01,"'^TXT-186,0,','PROVOZ'"
		ON [dvMyTP_03,25]
		}
	ELSE
		{
		SEND_COMMAND dvMyTP_03,"'^TXT-186,0,','OK'"
		OFF [dvMyTP_03,25]
		}
	IF (NAPAJENI_C6=TRUE)
		{
		OFF [dvMyTP_03,26]
		}
	ELSE
		{
		ON [dvMyTP_03,26]
		}
	/////////// VYHODNOCENI PORUCHY	
	IF ((PORUCHA_A3=1)||(PORUCHA_A7=1)||(PORUCHA_B2=1)||(PORUCHA_C2=1))
		{
		PORUCHA_CERP3=TRUE  // TEZKA PORUCHA
		}
	ELSE IF ((NAPAJENI_A4=0)||(NAPAJENI_A8=0)||(NAPAJENI_B3=0)||(NAPAJENI_C3=0)||(NAPAJENI_C3=0))
		{
		PORUCHA_CERP3=TRUE  // PORUCHA NAPAJENI
		}
	ELSE IF ((NAPAJENI_A4=0)||(NAPAJENI_A8=0)||(NAPAJENI_B3=0)||(NAPAJENI_C3=0)||(NAPAJENI_C3=0))
		{
		PORUCHA_CERP3=FALSE
		PORUCHA_CERP2=TRUE  // LEHCI PORUCHA
		}
	ELSE IF ((PORUCHA_A1=1)||(PORUCHA_A5=1)||(PORUCHA_B1=1)||(PORUCHA_C1=1)(*||(PORUCHA_C4=1)*)||(PORUCHA_C5=1))
		{
		PORUCHA_CERP3=FALSE
		PORUCHA_CERP2=FALSE
		PORUCHA_CERP1=TRUE  // BEH CERPADEL
		}
	ELSE
		{
		PORUCHA_CERP1=FALSE  // BEH CERPADEL
		}
	CALL 'ZOBRAZ_STAV_CERPADEL'	
    }
DEFINE_CALL 'ZOBRAZ_STAV_CERPADEL'
	{
	IF (PORUCHA_CERP3=TRUE) // TEZKA PORUCHA
		{
		ON [dvMyTP_03,30]
		//SEND_COMMAND dvMyTP_01, "'@PPN-zavada_cepadla'"
		IF (POPUP_ON=FALSE)
		    {
		    SEND_COMMAND dvMyTP_01, "'@PPN-zavada_cepadla'"
		    POPUP_ON=TRUE
		    WAIT 2000
		    POPUP_ON=FALSE
		    }
		}
	ELSE IF (PORUCHA_CERP2=TRUE)
		{
		IF (ZOBRAZENO_TP=FALSE)
			{
			ZOBRAZENO_TP=TRUE
			IF (POPUP_ON=FALSE)
				{
				SEND_COMMAND dvMyTP_01, "'@PPN-zavada_cepadla'"
				POPUP_ON=TRUE
				WAIT 30
				SEND_COMMAND dvMyTP_01, "'@PPK-zavada_cepadla'"
				WAIT 9000
				POPUP_ON=FALSE
				}
			ON [dvMyTP_03,30]
			}
		
		}
	ELSE IF (PORUCHA_CERP1=TRUE) // BEH CERPADEL
		{
		ON [dvMyTP_03,30]
		ZOBRAZENO_TP=FALSE
		IF (POPUP_ON=TRUE)
			{
			SEND_COMMAND dvMyTP_01, "'@PPK-zavada_cepadla'"
			POPUP_ON=FALSE
			}
		}
	ELSE
		{
		OFF [dvMyTP_03,30]
		ZOBRAZENO_TP=FALSE
		IF (POPUP_ON=TRUE)
			{
			SEND_COMMAND dvMyTP_01, "'@PPK-zavada_cepadla'"
			POPUP_ON=FALSE
			}
		}
	//WAIT 5
	//CALL 'ZOBRAZ_TLACITKA_CERPADEL'
	}		
DEFINE_START


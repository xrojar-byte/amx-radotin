		PORUCHA_A1=1
	   }
	RELEASE:
	  {
	  //SEND_COMMAND dvMyTP_01,"'^UNI-16,0,004F004B'"	
	  OFF [dvMyTP_03,10]
	  PORUCHA_A1=0
	  }
}


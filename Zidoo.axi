PROGRAM_NAME='Zidoo'
(***********************************************************)
(*  FILE CREATED ON: 08/05/2011  AT: 11:53:47              *)
(***********************************************************)
(*  FILE_LAST_MODIFIED_ON: 08/31/2011  AT: 22:33:25        *)
(***********************************************************)

/////////////////////////////////////////////////////////////
///																												///
///																												///
///										Pro TV LG RS												///
///																												///
///																												///
/////////////////////////////////////////////////////////////

DEFINE_DEVICE

// dvZidoo = 5001:8:1 neco

DEFINE_CONSTANT

DEFINE_VARIABLE
VOLATILE CHAR ZIDOO_BUFFER[10000]
VOLATILE CHAR ZIDOO_TEMP[255]
VOLATILE CHAR ZIDOO_QUEUE[10000]
VOLATILE CHAR ZIDOO_BUSY
VOLATILE CHAR ZIDOO_POWER = FALSE
///	
					 				///
DEFINE_CALL 'ZIDOO_ON'   
{
	 CALL 'SEND_TO_ZIDOO_CMD'  ('POW')
	 ZIDOO_POWER = TRUE
	 ON [dvMyTP_01,364]
}

DEFINE_CALL 'ZIDOO_OFF'
{
	CALL 'SEND_TO_ZIDOO_CMD' ('#POF') 
	ZIDOO_POWER = FALSE
	OFF [dvMyTP_01,364]
}

DEFINE_CALL 'ZIDOO_POWER_TOGGLE'   
{
	IF	(ZIDOO_POWER = FALSE)
		{
		CALL 'ZIDOO_ON'
		ZIDOO_POWER = TRUE
		}
	ELSE
		{
		CALL 'ZIDOO_OFF'
		ZIDOO_POWER = FALSE
		}
}

DEFINE_CALL 'ZIDOO_OK'
{
	 CALL 'SEND_TO_ZIDOO_CMD'  ('#SEL')
}

DEFINE_CALL 'ZIDOO_ON_HEX'
{
	 CALL 'SEND_TO_ZIDOO_CMD'  ("$23,$50,$4F,$53,$0D,$0A")
}

DEFINE_CALL 'ZIDOO_VOLUME_0' 
{
	CALL 'SEND_TO_ZIDOO_CMD'  ("$6B,$66,$20,$31,$20,$30,$0D")
}

DEFINE_CALL 'SEND_TO_ZIDOO_CMD' (CHAR cCMD[])
{
	ZIDOO_QUEUE = "ZIDOO_QUEUE,cCMD,$0D" // PRIDAM DO FRONTY A PRIDAM ZACATEK+KONEC ZPRAVY
  IF (!(ZIDOO_BUSY)) // MUZEME POSLAT HNED, JINAK JEN NECHAME VE FRONTE
	{
	  CALL 'SEND_TO_ZIDOO_PORT' 
	}
}
DEFINE_CALL 'SEND_TO_ZIDOO_RC' (CHAR cCMD[])
{
	ZIDOO_QUEUE = "'@',ZIDOO_QUEUE,cCMD,$0D" // PRIDAM DO FRONTY A PRIDAM ZACATEK+KONEC ZPRAVY
  IF (!(ZIDOO_BUSY)) // MUZEME POSLAT HNED, JINAK JEN NECHAME VE FRONTE
	{
	  CALL 'SEND_TO_ZIDOO_PORT' 
	}
}

DEFINE_CALL 'SEND_TO_ZIDOO_PORT'
{
	ZIDOO_TEMP = REMOVE_STRING(ZIDOO_QUEUE,"$0D",1)
	IF (LENGTH_STRING(ZIDOO_TEMP) > 0)
	{
		CANCEL_WAIT 'ZIDOO_TIMEOUT_BUSY' 
		ZIDOO_BUSY = TRUE
    SEND_STRING dvZidoo,"ZIDOO_TEMP"		
		WAIT 0.5 'ZIDOO_TIMEOUT_BUSY'
		{
			ZIDOO_BUSY = FALSE
		}
	}
	ELSE  (* Garbage *)
	{
		ZIDOO_QUEUE = "''"
	}
}

DEFINE_CALL 'ZIDOO_BUFFER_PROCESS'
{
  IF (LENGTH_STRING(ZIDOO_BUFFER) > 1)
  {
		ZIDOO_TEMP = REMOVE_STRING(ZIDOO_BUFFER,"$0D,$0A",1)
		IF (LENGTH_STRING(ZIDOO_TEMP)) // JE TAM ALESPON JEDNA CELA ZPRAVA, ZPRACUJU
		{
			SEND_STRING 0,"'ZIDOO: <',ZIDOO_TEMP,'>'"
			// PO ZPRACOVANI JEDNE ZPRAVY ZNOVU DOTAZ, JE-LI CO ZPRACOVAVAT, VOLAT ZNOVU
			IF (FIND_STRING(ZIDOO_TEMP,"'POW'",1)) // 
				{
				REMOVE_STRING(ZIDOO_TEMP,"'POW'",1) // ODSTRANIM VSE DO PRIZNAKU ZACATKU ZPRAVY VCETNE
				SET_LENGTH_STRING(ZIDOO_TEMP,(LENGTH_STRING(ZIDOO_TEMP)-1)) // ODSTRANIM KONEC ZPRAVY
				ON [dvMyTP_01,364]
				ZIDOO_POWER = TRUE
				}
			ELSE IF (FIND_STRING(ILT_TEMP,"'POF'",1)) // 
				{
				REMOVE_STRING(ZIDOO_TEMP,"'POF'",1) // ODSTRANIM VSE DO PRIZNAKU ZACATKU ZPRAVY VCETNE
				SET_LENGTH_STRING(ZIDOO_TEMP,(LENGTH_STRING(ZIDOO_TEMP)-1)) // ODSTRANIM KONEC ZPRAVY
				OFF [dvMyTP_01,364]
				ZIDOO_POWER = FALSE
				}
				
		IF (LENGTH_STRING(ZIDOO_BUFFER))
				{
					CALL 'ZIDOO_BUFFER_PROCESS'
				}			
		}
    IF (LENGTH_STRING(ZIDOO_TEMP) >= MAX_LENGTH_STRING(ZIDOO_TEMP)) // MAME NESMYSLY V BUFFERU, TAK HO VYCISTIM
		{
		  CLEAR_BUFFER ZIDOO_BUFFER
		}
	}
}


DEFINE_START

DEFINE_EVENT
DATA_EVENT[dvZidoo]
{
	ONLINE:
	{
		SEND_COMMAND dvZidoo, "'SET BAUD 9600 N,8,1 485 DISABLE'"
		ZIDOO_BUSY = FALSE
		ZIDOO_QUEUE = "''"
		ZIDOO_BUFFER = "''"	
		WAIT 40		
		CALL 'ZIDOO_BUFFER_PROCESS'
	}
}

DEFINE_PROGRAM

IF (LENGTH_STRING(ZIDOO_QUEUE))  (* WE HAVE SOMETHING TO SEND *)
	{
	IF (!(ZIDOO_BUSY))
		CALL 'SEND_TO_ZIDOO_PORT'
	}
ELSE
	{
	WAIT 80
		{
		CALL 'ZIDOO_BUFFER_PROCESS'
		}
	}
	
(***********************************************************)
(*                     END OF PROGRAM                      *)
(*        DO NOT PUT ANY CODE BELOW THIS COMMENT           *)
(***********************************************************)

